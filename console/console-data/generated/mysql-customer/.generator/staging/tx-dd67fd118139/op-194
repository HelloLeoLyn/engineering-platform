// DepartmentTree + DictionarySelect tests (generated by engineering-platform frontend-enterprise-management asset)
import { describe, it, expect, vi, beforeEach } from 'vitest';
import { mount, flushPromises } from '@vue/test-utils';
import DepartmentTree from '../src/components/DepartmentTree.vue';
import DictionarySelect from '../src/components/DictionarySelect.vue';
import { departmentApi, dictionaryApi } from '../src/api/enterprise';
import type { DepartmentNode } from '../src/types/enterprise';

const tree: DepartmentNode[] = [
  {
    department: { id: '1', parentId: null, code: 'HQ', name: 'HQ', enabled: true, sort: 1, createdAt: '', updatedAt: '' },
    children: [
      {
        department: { id: '2', parentId: '1', code: 'SALES', name: 'Sales', enabled: true, sort: 1, createdAt: '', updatedAt: '' },
        children: [],
      },
      {
        department: { id: '3', parentId: '1', code: 'FIN', name: 'Finance', enabled: false, sort: 2, createdAt: '', updatedAt: '' },
        children: [],
      },
    ],
  },
];

describe('DepartmentTree', () => {
  beforeEach(() => {
    vi.restoreAllMocks();
  });

  it('uses provided nodes when selfLoad=false', () => {
    const wrapper = mount(DepartmentTree, {
      props: { nodes: tree, selfLoad: false },
      global: { stubs: ['el-tree', 'el-button'] },
    });
    expect(wrapper.find('[data-testid="department-tree"]').exists()).toBe(true);
  });

  it('loads from backend when selfLoad=true and emits select', async () => {
    vi.spyOn(departmentApi, 'tree').mockResolvedValue(tree);
    const wrapper = mount(DepartmentTree, {
      props: { selfLoad: true },
      global: { stubs: ['el-tree', 'el-button'] },
    });
    await flushPromises();
    const emitted = wrapper.emitted('loaded');
    expect(emitted).toBeTruthy();
    expect(emitted![0][0]).toEqual(tree);
  });

  it('shows error and retries', async () => {
    vi.spyOn(departmentApi, 'tree').mockRejectedValueOnce(new Error('net'));
    const wrapper = mount(DepartmentTree, {
      props: { selfLoad: true },
      global: { stubs: ['el-tree', 'el-button'] },
    });
    await flushPromises();
    expect(wrapper.find('.department-tree-error').exists()).toBe(true);
  });

  it('marks disabled nodes', () => {
    const wrapper = mount(DepartmentTree, {
      props: { nodes: tree, selfLoad: false },
      global: { stubs: ['el-tree', 'el-button'] },
    });
    expect(wrapper.find('[data-testid="department-tree"]').exists()).toBe(true);
  });
});

describe('DictionarySelect', () => {
  beforeEach(() => {
    vi.restoreAllMocks();
  });

  it('loads items by code and emits update:modelValue', async () => {
    vi.spyOn(dictionaryApi, 'itemsByCode').mockResolvedValue([
      { id: '1', typeId: '1', value: 'DRAFT', label: 'Draft', enabled: true, sort: 1, description: null, createdAt: '', updatedAt: '' },
      { id: '2', typeId: '1', value: 'RELEASED', label: 'Released', enabled: true, sort: 2, description: null, createdAt: '', updatedAt: '' },
    ]);
    const wrapper = mount(DictionarySelect, {
      props: { code: 'product_status' },
      global: { stubs: ['el-select', 'el-option'] },
    });
    await flushPromises();
    const select = wrapper.findComponent({ name: 'ElSelect' });
    expect(select.exists()).toBe(true);
  });

  it('shows error text on failure', async () => {
    vi.spyOn(dictionaryApi, 'itemsByCode').mockRejectedValue(new Error('DICTIONARY_TYPE_NOT_FOUND'));
    const wrapper = mount(DictionarySelect, {
      props: { code: 'missing' },
      global: { stubs: ['el-select', 'el-option'] },
    });
    await flushPromises();
    expect(wrapper.find('.dictionary-select-error').exists()).toBe(true);
  });

  it('emits selected value', async () => {
    vi.spyOn(dictionaryApi, 'itemsByCode').mockResolvedValue([
      { id: '1', typeId: '1', value: 'DRAFT', label: 'Draft', enabled: true, sort: 1, description: null, createdAt: '', updatedAt: '' },
    ]);
    const wrapper = mount(DictionarySelect, {
      props: { code: 'product_status' },
      global: { stubs: ['el-select', 'el-option'] },
    });
    await flushPromises();
    wrapper.findComponent({ name: 'ElSelect' }).vm.$emit('update:modelValue', 'DRAFT');
    expect(wrapper.emitted('update:modelValue')![0]).toEqual(['DRAFT']);
  });
});
