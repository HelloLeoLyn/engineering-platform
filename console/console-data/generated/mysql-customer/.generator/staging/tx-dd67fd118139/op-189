<script setup lang="ts">
// Menu Management (generated by engineering-platform frontend-enterprise-management asset)
// Tree + workspace pattern: menu tree (left) + detail/edit (right).
// Type-driven fields: DIRECTORY (path/permission optional), MENU (path required),
// ACTION (permissionCode focus). permissionCode is a selector, never free-text.
import { computed, onMounted, reactive, ref } from 'vue';
import PageHeader from '../../components/PageHeader.vue';
import PageContainer from '../../components/PageContainer.vue';
import StatusTag from '../../components/StatusTag.vue';
import ConfirmAction from '../../components/ConfirmAction.vue';
import PermissionButton from '../../permission/PermissionButton.vue';
import { menuApi, permissionApi } from '../../api/enterprise';
import type { Menu, MenuNode, MenuType, Permission, EntityId } from '../../types/enterprise';
import { flattenMenus } from '../../utils/tree';
import { errorMessage, notifySuccess, toastSuccess } from '../../utils/feedback';

const tree = ref<MenuNode[]>([]);
const treeError = ref<string | null>(null);
const selected = ref<Menu | null>(null);
const creating = ref(false);
const editing = ref(false);
const saving = ref(false);
const formError = ref<string | null>(null);
const permissions = ref<Permission[]>([]);

const MENU_TYPES: { value: MenuType; label: string; hint: string }[] = [
  { value: 'DIRECTORY', label: 'Directory', hint: 'A navigation group. Path & permission optional.' },
  { value: 'MENU', label: 'Menu', hint: 'A navigable page. Path is expected.' },
  { value: 'ACTION', label: 'Action', hint: 'A capability action. Permission code is the focus.' },
];

const form = reactive({
  code: '',
  name: '',
  type: 'MENU' as MenuType,
  path: '',
  permissionCode: null as string | null,
  parentId: null as EntityId | null,
  sort: 0,
});

const parentOptions = computed(() => {
  const all = flattenMenus(tree.value);
  const exclude = new Set<EntityId>();
  if (selected.value) {
    exclude.add(selected.value.id);
    const collect = (nodes: MenuNode[], fromId: EntityId): void => {
      for (const n of nodes) {
        if (n.menu.id === fromId) {
          const walk = (list: MenuNode[]): void => {
            for (const c of list) {
              exclude.add(c.menu.id);
              walk(c.children);
            }
          };
          walk(n.children);
          return;
        }
        collect(n.children, fromId);
      }
    };
    collect(tree.value, selected.value.id);
  }
  return all.filter((m) => !exclude.has(m.id));
});

const permissionOptions = computed(() =>
  permissions.value.map((p) => ({ code: p.code, name: p.name })),
);

const typeHint = computed(() => MENU_TYPES.find((t) => t.value === form.type)?.hint ?? '');

async function loadTree(): Promise<void> {
  try {
    tree.value = await menuApi.tree();
    treeError.value = null;
  } catch (e) {
    treeError.value = errorMessage(e);
  }
}

async function loadPermissions(): Promise<void> {
  try {
    permissions.value = await permissionApi.list();
  } catch {
    permissions.value = [];
  }
}

function onSelect(id: EntityId): void {
  const found = flattenMenus(tree.value).find((m) => m.id === id);
  if (found) {
    selected.value = found;
    creating.value = false;
    editing.value = false;
    formError.value = null;
    syncForm(found);
  }
}

function onMenuClick(data: MenuNode): void {
  onSelect(data.menu.id);
}

function syncForm(m: Menu): void {
  Object.assign(form, {
    code: m.code,
    name: m.name,
    type: m.type,
    path: m.path ?? '',
    permissionCode: m.permissionCode,
    parentId: m.parentId,
    sort: m.sort,
  });
}

function startCreate(): void {
  creating.value = true;
  editing.value = false;
  formError.value = null;
  Object.assign(form, {
    code: '',
    name: '',
    type: 'MENU',
    path: '',
    permissionCode: null,
    parentId: selected.value?.id ?? null,
    sort: 0,
  });
}

function startEdit(): void {
  if (!selected.value) {
    return;
  }
  editing.value = true;
  creating.value = false;
  formError.value = null;
  syncForm(selected.value);
}

async function save(): Promise<void> {
  saving.value = true;
  formError.value = null;
  try {
    const payload = {
      parentId: form.parentId,
      name: form.name,
      path: form.path || null,
      permissionCode: form.permissionCode,
      sort: form.sort,
    };
    if (creating.value) {
      const created = await menuApi.create({
        ...payload,
        code: form.code,
        type: form.type,
      });
      notifySuccess('Menu created');
      await loadTree();
      onSelect(created.id);
    } else if (selected.value) {
      const updated = await menuApi.update(selected.value.id, payload);
      notifySuccess('Menu updated');
      await loadTree();
      onSelect(updated.id);
    }
    creating.value = false;
    editing.value = false;
  } catch (e) {
    formError.value = errorMessage(e);
  } finally {
    saving.value = false;
  }
}

async function setEnabled(m: Menu, enabled: boolean): Promise<void> {
  try {
    if (enabled) {
      await menuApi.enable(m.id);
      toastSuccess('Menu enabled');
    } else {
      await menuApi.disable(m.id);
      toastSuccess('Menu disabled');
    }
    await loadTree();
    if (selected.value?.id === m.id) {
      selected.value = { ...m, enabled };
      syncForm(selected.value);
    }
  } catch (e) {
    toastSuccess(errorMessage(e));
  }
}

function cancelEdit(): void {
  creating.value = false;
  editing.value = false;
  formError.value = null;
  if (selected.value) {
    syncForm(selected.value);
  }
}

onMounted(async () => {
  await Promise.all([loadTree(), loadPermissions()]);
});
</script>

<template>
  <PageContainer full-width>
    <PageHeader title="Menu Management" description="Define navigation and capability actions. Structure is validated against cycles.">
      <template #actions>
        <PermissionButton permission="system:menu:create" type="primary" data-testid="create-menu" @click="startCreate">
          Create Menu
        </PermissionButton>
      </template>
    </PageHeader>

    <div class="menu-layout" data-testid="menu-layout">
      <aside class="menu-tree-pane">
        <div v-if="treeError" class="tree-error">
          <span>{{ treeError }}</span>
          <el-button size="small" @click="loadTree">Retry</el-button>
        </div>
        <el-tree
          v-else
          :data="tree"
          :props="{ label: 'menu.name', children: 'children' }"
          node-key="id"
          :default-expand-all="true"
          highlight-current
          :current-node-key="selected?.id ?? undefined"
          data-testid="menu-tree"
          @node-click="onMenuClick"
        >
          <template #default="{ node, data }">
            <span :data-testid="'menu-node-' + (data.menu.id)">
              {{ node.label }}
              <el-tag v-if="data.menu.type !== 'MENU'" size="small" type="info" class="menu-type-tag">
                {{ data.menu.type }}
              </el-tag>
            </span>
          </template>
        </el-tree>
      </aside>

      <main class="menu-workspace" data-testid="menu-workspace">
        <el-empty v-if="!selected && !creating" description="Select a menu on the left" />
        <div v-else>
          <el-alert v-if="formError" type="error" :title="formError" :closable="false" class="form-alert" />
          <div class="workspace-header">
            <div>
              <h3 class="workspace-title">{{ creating ? 'New menu' : (selected?.name ?? '') }}</h3>
              <span v-if="!creating && selected" class="workspace-subtitle">{{ selected?.code }}</span>
            </div>
            <div v-if="!creating && selected" class="workspace-header-actions">
              <StatusTag :enabled="selected!.enabled" />
              <PermissionButton v-if="!editing" permission="system:menu:update" data-testid="edit-menu" @click="startEdit">
                Edit
              </PermissionButton>
              <ConfirmAction
                v-if="!editing && selected!.enabled"
                title="Disable this menu?"
                message="Disabled menus are hidden from navigation."
                data-testid="disable-menu-confirm"
              >
                <PermissionButton permission="system:menu:disable" type="danger" plain>Disable</PermissionButton>
              </ConfirmAction>
              <PermissionButton
                v-if="!editing && !selected!.enabled"
                permission="system:menu:update"
                data-testid="enable-menu"
                @click="setEnabled(selected!, true)"
              >
                Enable
              </PermissionButton>
            </div>
          </div>

          <el-form :model="form" label-width="140px" class="menu-form">
            <el-form-item label="Type">
              <el-select v-model="form.type" style="width: 100%" data-testid="menu-form-type">
                <el-option v-for="t in MENU_TYPES" :key="t.value" :label="t.label" :value="t.value" />
              </el-select>
              <div class="form-hint">{{ typeHint }}</div>
            </el-form-item>
            <el-form-item label="Code" :rules="[{ required: true, message: 'Code is required' }]">
              <el-input v-model="form.code" :disabled="!creating" placeholder="e.g. system-user" data-testid="menu-form-code" />
              <div v-if="!creating" class="form-hint">Code is immutable once created.</div>
            </el-form-item>
            <el-form-item label="Name">
              <el-input v-model="form.name" data-testid="menu-form-name" />
            </el-form-item>
            <el-form-item label="Parent">
              <el-select
                v-model="form.parentId"
                clearable
                filterable
                placeholder="Root"
                style="width: 100%"
                data-testid="menu-form-parent"
              >
                <el-option v-for="m in parentOptions" :key="m.id" :label="m.name" :value="m.id" />
              </el-select>
            </el-form-item>
            <el-form-item v-if="form.type !== 'ACTION'" label="Path">
              <el-input
                v-model="form.path"
                placeholder="/system/users"
                :class="{ 'is-required': form.type === 'MENU' }"
                data-testid="menu-form-path"
              />
              <div v-if="form.type === 'MENU'" class="form-hint">Path is expected for menus.</div>
            </el-form-item>
            <el-form-item v-if="form.type !== 'DIRECTORY'" label="Permission code">
              <el-select
                v-model="form.permissionCode"
                clearable
                filterable
                placeholder="Select a permission"
                style="width: 100%"
                data-testid="menu-form-permission"
              >
                <el-option
                  v-for="p in permissionOptions"
                  :key="p.code"
                  :label="(p.code) + ' — ' + (p.name)"
                  :value="p.code"
                />
              </el-select>
              <div v-if="form.type === 'ACTION'" class="form-hint">Actions are driven by this permission.</div>
            </el-form-item>
            <el-form-item label="Sort">
              <el-input-number v-model="form.sort" :min="0" data-testid="menu-form-sort" />
            </el-form-item>
          </el-form>

          <div v-if="editing || creating" class="workspace-actions">
            <el-button @click="cancelEdit">Cancel</el-button>
            <el-button type="primary" :loading="saving" data-testid="menu-save" @click="save">
              {{ creating ? 'Create' : 'Save' }}
            </el-button>
          </div>
        </div>
      </main>
    </div>
  </PageContainer>
</template>

