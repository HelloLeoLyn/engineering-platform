package com.acme.core.application.organization;

import com.acme.core.common.core.ErrorCode;
import com.acme.core.common.core.PlatformException;
import com.acme.core.domain.entity.SysDepartment;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDateTime;
import java.util.List;
import java.util.Optional;

/**
 * Department management application service (generated by engineering-platform 0.1.0).
 *
 * Orchestration, business validation and transaction boundaries live here, in
 * the application layer. Persistence goes through {@link DepartmentManagementPort};
 * structural safety (self-parent, cycle, invalid parent, stable ordering) is
 * delegated to {@link DepartmentService}. No MyBatis types appear in this class.
 *
 * create / update / enable / disable.
 */
public class DepartmentManagementService {

    private final DepartmentManagementPort managementPort;
    private final DepartmentService departmentService;

    public DepartmentManagementService(DepartmentManagementPort managementPort,
                                       DepartmentService departmentService) {
        this.managementPort = managementPort;
        this.departmentService = departmentService;
    }

    public SysDepartment detail(Long id) {
        Optional<SysDepartment> dept = managementPort.findById(id);
        if (dept.isEmpty()) {
            throw new PlatformException(ErrorCode.of("DEPARTMENT_NOT_FOUND",
                    "department not found: " + id));
        }
        return dept.get();
    }

    @Transactional
    public SysDepartment create(String code, String name, Long parentId, Integer sort) {
        if (code == null || code.isBlank()) {
            throw new PlatformException(ErrorCode.of("DEPARTMENT_CODE_REQUIRED",
                    "department code is required"));
        }
        String normalizedCode = code.trim();
        if (!normalizedCode.matches("[A-Z][A-Z0-9_]{1,63}")) {
            throw new PlatformException(ErrorCode.of("DEPARTMENT_CODE_INVALID",
                    "department code format invalid"));
        }
        if (managementPort.codeExists(normalizedCode)) {
            throw new PlatformException(ErrorCode.of("DEPARTMENT_CODE_DUPLICATE",
                    "department code already exists: " + normalizedCode));
        }
        if (parentId != null && managementPort.findById(parentId).isEmpty()) {
            throw new PlatformException(ErrorCode.of("DEPARTMENT_NOT_FOUND",
                    "parent department not found: " + parentId));
        }
        SysDepartment dept = new SysDepartment();
        dept.setCode(normalizedCode);
        dept.setName(name == null || name.isBlank() ? normalizedCode : name.trim());
        dept.setParentId(parentId);
        dept.setEnabled(true);
        dept.setSort(sort == null ? 0 : sort);
        LocalDateTime now = LocalDateTime.now();
        dept.setCreatedAt(now);
        dept.setUpdatedAt(now);
        managementPort.insert(dept);
        return dept;
    }

    @Transactional
    public SysDepartment update(Long id, String name, Long parentId, Integer sort) {
        SysDepartment dept = requireDepartment(id);
        if (name != null && !name.isBlank()) {
            dept.setName(name.trim());
        }
        if (parentId != null && !parentId.equals(dept.getParentId())) {
            // structural safety: self-parent / cycle / invalid parent via service
            if (parentId.equals(id)) {
                throw new PlatformException(ErrorCode.of("DEPARTMENT_SELF_PARENT",
                        "department cannot be its own parent"));
            }
            if (managementPort.findById(parentId).isEmpty()) {
                throw new PlatformException(ErrorCode.of("DEPARTMENT_NOT_FOUND",
                        "parent department not found: " + parentId));
            }
            dept.setParentId(parentId);
            // run full cycle validation against current data
            departmentService.validateStructure(managementPort.findAll());
        }
        if (sort != null) {
            dept.setSort(sort);
        }
        dept.setUpdatedAt(LocalDateTime.now());
        managementPort.update(dept);
        return dept;
    }

    @Transactional
    public SysDepartment setEnabled(Long id, boolean enabled) {
        SysDepartment dept = requireDepartment(id);
        dept.setEnabled(enabled);
        dept.setUpdatedAt(LocalDateTime.now());
        managementPort.update(dept);
        return dept;
    }

    private SysDepartment requireDepartment(Long id) {
        Optional<SysDepartment> dept = managementPort.findById(id);
        if (dept.isEmpty()) {
            throw new PlatformException(ErrorCode.of("DEPARTMENT_NOT_FOUND",
                    "department not found: " + id));
        }
        return dept.get();
    }
}
