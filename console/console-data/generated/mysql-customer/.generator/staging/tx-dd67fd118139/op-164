<script setup lang="ts">
// PermissionButton (generated by engineering-platform frontend-permission asset)
// Element Plus button wrapped with permission visibility. UX only.
import { computed } from 'vue';
import { hasAnyPermission } from './index';

const props = withDefaults(
  defineProps<{
    permission: string | string[];
  }>(),
  {},
);

const allowed = computed(() =>
  hasAnyPermission(Array.isArray(props.permission) ? props.permission : [props.permission]),
);
</script>

<template>
  <el-button v-if="allowed" v-bind="$attrs">
    <slot />
  </el-button>
</template>
