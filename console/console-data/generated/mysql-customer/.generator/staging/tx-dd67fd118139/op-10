package com.acme.core.common.core;

/**
 * Page query contract (generated by engineering-platform 0.1.0).
 * Persistence-framework neutral: no IPage / Page / Wrapper exposure.
 */
public record PageQuery(int page, int size) {

    public static final int DEFAULT_PAGE = 1;
    public static final int DEFAULT_SIZE = 20;
    public static final int MAX_SIZE = 1000;

    public PageQuery {
        if (page < 1) {
            page = DEFAULT_PAGE;
        }
        if (size < 1) {
            size = DEFAULT_SIZE;
        }
        if (size > MAX_SIZE) {
            size = MAX_SIZE;
        }
    }

    public static PageQuery of(int page, int size) {
        return new PageQuery(page, size);
    }

    public static PageQuery defaults() {
        return new PageQuery(DEFAULT_PAGE, DEFAULT_SIZE);
    }

    /** Zero-based offset for SQL LIMIT/OFFSET (framework-neutral). */
    public long offset() {
        return (long) (page - 1) * size;
    }
}
