// Supplier API service tests (generated by engineering-platform Generic Module Generator)
import { describe, it, expect, vi, beforeEach } from 'vitest';
import { http } from '../src/api/request';
import { supplierApi } from '../src/api/supplier';
import type { Supplier } from '../src/types/supplier';

const row: Supplier = { id: '1', code: 'v', name: 'v', status: 'v', category: 'v', departmentId: '1', createdBy: '1', createdAt: '2026-08-16T00:00:00', updatedAt: '2026-08-16T00:00:00' };

describe('supplierApi', () => {
  beforeEach(() => { vi.restoreAllMocks(); });

  it('page builds query string', async () => {
    const spy = vi.spyOn(http, 'get').mockResolvedValue({ items: [row], total: 1, page: 1, size: 20 });
    await supplierApi.page({ page: 1, size: 20, keyword: 'x' });
    const [path] = spy.mock.calls[0] as [string];
    expect(path).toContain('page=1');
    expect(path).toContain('keyword=x');
  });

  it('detail/create/update/disable route to the right paths', async () => {
    const get = vi.spyOn(http, 'get').mockResolvedValue(row);
    const post = vi.spyOn(http, 'post').mockResolvedValue(row);
    const put = vi.spyOn(http, 'put').mockResolvedValue(row);
    await supplierApi.detail('5');
    expect((get.mock.calls[0] as [string])[0]).toBe('/supplier/5');
    await supplierApi.create({ id: '0' } as never);
    expect((post.mock.calls[0] as [string])[0]).toBe('/supplier');
    await supplierApi.update('5', { id: '0' } as never);
    expect((put.mock.calls[0] as [string])[0]).toBe('/supplier/5');
    await supplierApi.disable('5');
    expect((post.mock.calls[1] as [string])[0]).toBe('/supplier/5/disable');
  });
});
