package com.acme.core.infrastructure.persistence;

import com.acme.core.application.menu.MenuManagementPort;
import com.acme.core.domain.entity.SysMenu;
import com.acme.core.domain.entity.SysPermission;
import com.acme.core.infrastructure.persistence.mapper.SysMenuMapper;
import com.acme.core.infrastructure.persistence.mapper.SysPermissionMapper;
import com.baomidou.mybatisplus.core.conditions.query.QueryWrapper;

import java.util.List;
import java.util.Optional;

/**
 * MyBatis-Plus implementation of {@link MenuManagementPort} (generated by engineering-platform 0.1.0).
 *
 * All MyBatis-Plus technical types (QueryWrapper / BaseMapper) stay confined
 * here, in the infrastructure layer.
 */
public class MybatisMenuManagementRepository implements MenuManagementPort {

    private final SysMenuMapper menuMapper;
    private final SysPermissionMapper permissionMapper;

    public MybatisMenuManagementRepository(SysMenuMapper menuMapper, SysPermissionMapper permissionMapper) {
        this.menuMapper = menuMapper;
        this.permissionMapper = permissionMapper;
    }

    @Override
    public Optional<SysMenu> findById(Long menuId) {
        return Optional.ofNullable(menuMapper.selectById(menuId));
    }

    @Override
    public List<SysMenu> findAll() {
        return menuMapper.selectList(
                new QueryWrapper<SysMenu>().orderByAsc("sort", "id"));
    }

    @Override
    public boolean codeExists(String code) {
        return menuMapper.selectCount(new QueryWrapper<SysMenu>().eq("code", code)) > 0;
    }

    @Override
    public boolean permissionCodeExists(String permissionCode) {
        return permissionMapper.selectCount(new QueryWrapper<SysPermission>()
                .eq("code", permissionCode)) > 0;
    }

    @Override
    public void insert(SysMenu menu) {
        menuMapper.insert(menu);
    }

    @Override
    public void update(SysMenu menu) {
        menuMapper.updateById(menu);
    }
}
