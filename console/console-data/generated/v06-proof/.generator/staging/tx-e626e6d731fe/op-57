package com.acme.core.infrastructure.persistence;

import com.acme.core.application.rbac.PermissionManagementPort;
import com.acme.core.domain.entity.SysPermission;
import com.acme.core.infrastructure.persistence.mapper.SysPermissionMapper;
import com.baomidou.mybatisplus.core.conditions.query.QueryWrapper;

import java.util.List;
import java.util.Optional;

/**
 * MyBatis-Plus implementation of {@link PermissionManagementPort} (generated by engineering-platform 0.1.0).
 *
 * READ-ONLY registry-style governance. All MyBatis technical types stay
 * confined here, in the infrastructure layer.
 */
public class MybatisPermissionManagementRepository implements PermissionManagementPort {

    private final SysPermissionMapper permissionMapper;

    public MybatisPermissionManagementRepository(SysPermissionMapper permissionMapper) {
        this.permissionMapper = permissionMapper;
    }

    @Override
    public List<SysPermission> list(String code) {
        QueryWrapper<SysPermission> wrapper = new QueryWrapper<>();
        if (code != null && !code.isBlank()) {
            wrapper.like("code", code);
        }
        wrapper.orderByAsc("code");
        return permissionMapper.selectList(wrapper);
    }

    @Override
    public Optional<SysPermission> findById(Long permissionId) {
        return Optional.ofNullable(permissionMapper.selectById(permissionId));
    }
}
