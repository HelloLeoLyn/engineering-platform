  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: var(--ep-space-4);
  margin-bottom: var(--ep-space-5);
}
.form-hint { font-size: var(--ep-font-size-sm); color: var(--ep-color-info); padding: 0 var(--ep-space-2); }
