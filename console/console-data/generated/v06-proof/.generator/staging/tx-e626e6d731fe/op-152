                <el-dropdown-item disabled class="app-account-hint">Signed in as {{ displayName }}</el-dropdown-item>
                <el-dropdown-item divided data-testid="app-logout" @click="handleLogout">
                  <el-icon class="app-dropdown-icon"><SwitchButton /></el-icon>
                  Sign out
                </el-dropdown-item>
              </el-dropdown-menu>
            </template>
          </el-dropdown>
        </div>
      </header>

      <!-- Content -->
      <main class="app-content">
        <router-view />
      </main>
    </div>
  </div>
