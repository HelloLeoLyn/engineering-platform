<script setup lang="ts">
// App layout (generated by engineering-platform frontend-auth asset)
// V06-WORK-003B — Enterprise App Shell 2.0 (Visual Refinement)
//   - Sidebar 2.0: complete brand block, deterministic per-item icons
//     (generic icon pool keyed by menu code hash — NO business-name
//     branching), soft tinted active state, clear submenu hierarchy
//   - Topbar 2.0: collapse + breadcrumb left; quick action, notification
//     placeholder, avatar + name + compact account dropdown right
//   - Canvas-based content area; surfaces layered by bg/spacing/shadow
import { computed, ref, onMounted } from 'vue';
import { useRoute, useRouter } from 'vue-router';
import { useAuthStore } from '../stores/auth';
import { menuApi, type MenuNode } from '../api/menu';

const auth = useAuthStore();
const route = useRoute();
const router = useRouter();
const collapsed = ref(false);
const menus = ref<MenuNode[]>([]);

const displayName = computed(
  () => auth.currentUser?.username ?? 'user',
);

// Deterministic generic icon pool (Element Plus icon component names).
// Menu code hash -> stable icon; DIRECTORY uses a folder glyph. Purely
// generic: no module/business name appears anywhere in this mapping.
const ICON_POOL = [
  'Grid', 'DataBoard', 'Setting', 'Document', 'FolderOpened', 'Box',
  'Flag', 'Monitor', 'Tickets', 'Compass', 'TrendCharts', 'Files',
] as const;

function menuIcon(code: string): string {
  let h = 0;
  for (let i = 0; i < code.length; i++) {
    h = (h * 31 + code.charCodeAt(i)) >>> 0;
  }
  return ICON_POOL[h % ICON_POOL.length];
}

function nodeIcon(node: MenuNode): string {
  if (node.menu.type === 'DIRECTORY') return 'FolderOpened';
  return menuIcon(node.menu.code);
}

// Breadcrumb: derive from the route meta chain (menu path aligned).
const breadcrumb = computed(() => {
  const metaTitle = route.meta?.title as string | undefined;
  const parts: string[] = [];
  if (route.path !== '/') {
    parts.push('Home');
  }
  if (metaTitle) {
    parts.push(metaTitle);
  }
  return parts;
});

function handleLogout(): void {
  auth.logout();
  router.push({ path: '/login' });
}

onMounted(async () => {
  try {
    menus.value = await menuApi.me();
  } catch {
    menus.value = [];
  }
});
</script>

<template>
