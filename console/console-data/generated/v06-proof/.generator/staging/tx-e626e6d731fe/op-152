    <!-- Sidebar 2.0 -->
    <aside class="app-sidebar">
      <div class="app-brand">
        <div class="app-brand-mark">EP</div>
        <transition name="fade">
          <div v-if="!collapsed" class="app-brand-text">
            <span class="app-brand-name">Engineering Platform</span>
            <span class="app-brand-sub">Enterprise Workspace</span>
          </div>
        </transition>
      </div>

      <el-scrollbar class="app-sidebar-scroll">
        <el-menu
          :collapse="collapsed"
          :default-active="route.path"
          router
          class="app-menu"
        >
          <template v-for="node in menus" :key="node.menu.code">
            <el-sub-menu v-if="node.menu.type === 'DIRECTORY'" :index="node.menu.code" class="app-menu-group">
              <template #title>
                <el-icon class="app-menu-icon"><component :is="nodeIcon(node)" /></el-icon>
                <span>{{ node.menu.name }}</span>
              </template>
              <el-menu-item
                v-for="child in node.children"
                :key="child.menu.code"
                :index="child.menu.path ?? child.menu.code"
              >
                <el-icon class="app-menu-icon"><component :is="menuIcon(child.menu.code)" /></el-icon>
                <template #title>{{ child.menu.name }}</template>
              </el-menu-item>
            </el-sub-menu>
            <el-menu-item v-else :index="node.menu.path ?? node.menu.code">
              <el-icon class="app-menu-icon"><component :is="nodeIcon(node)" /></el-icon>
              <template #title>{{ node.menu.name }}</template>
            </el-menu-item>
          </template>
        </el-menu>
      </el-scrollbar>
    </aside>

    <!-- Main column -->
    <div class="app-main-column">
      <!-- Topbar 2.0 -->
      <header class="app-topbar">
        <div class="app-topbar-left">
          <el-button text class="app-collapse-btn" data-testid="app-collapse-toggle" @click="collapsed = !collapsed">
            <el-icon :size="18">
              <component :is="collapsed ? 'Expand' : 'Fold'" />
            </el-icon>
          </el-button>
          <nav v-if="breadcrumb.length" class="app-breadcrumb" data-testid="app-breadcrumb">
            <template v-for="(crumb, i) in breadcrumb" :key="i">
              <span class="app-breadcrumb-item" :class="{ 'is-last': i === breadcrumb.length - 1 }">
                {{ crumb }}
              </span>
              <span v-if="i < breadcrumb.length - 1" class="app-breadcrumb-sep">/</span>
            </template>
          </nav>
        </div>

        <div class="app-topbar-right">
          <el-button text class="app-topbar-action" aria-label="Notifications">
            <el-badge :is-dot="true" class="app-notification-badge">
              <el-icon :size="18"><Bell /></el-icon>
            </el-badge>
          </el-button>
          <el-dropdown trigger="click" data-testid="app-account-menu">
            <div class="app-user" data-testid="app-user">
              <span class="app-user-avatar">{{ displayName.charAt(0).toUpperCase() }}</span>
              <span class="app-user-name">{{ displayName }}</span>
              <el-icon class="app-user-caret" :size="12"><ArrowDown /></el-icon>
            </div>
            <template #dropdown>
