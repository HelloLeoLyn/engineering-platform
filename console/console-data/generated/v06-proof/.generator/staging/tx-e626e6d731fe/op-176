<script setup lang="ts">
// AppForm (generated by engineering-platform frontend-enterprise-management asset)
// V06-WORK-003B EP UI 2.0 (Visual Refinement): unified form container with
// white card surface, optional 2-column grid (desktop-first), grouped field
// sections, validation, submit loading, dirty state, cancel, error feedback.
// Layout strategy: small form -> Dialog; medium edit -> Drawer; complex -> page.
import { ref, watch } from 'vue';
import type { FormInstance, FormRules } from 'element-plus';

const props = withDefaults(
  defineProps<{
    model: Record<string, unknown>;
    rules?: FormRules;
    labelWidth?: string;
    submitting?: boolean;
    error?: string | null;
    submitText?: string;
    cancelText?: string;
    /** Compact mode for drawers/dialogs (footer aligned right, no grouping gap). */
    compact?: boolean;
    /** Desktop-first 2-column field grid (long fields can span full width). */
    twoColumn?: boolean;
  }>(),
  {
    rules: undefined,
    labelWidth: '140px',
    submitting: false,
    error: null,
    submitText: 'Save',
    cancelText: 'Cancel',
    compact: false,
    twoColumn: false,
  },
);

const emit = defineEmits<{ submit: []; cancel: [] }>();

const formRef = ref<FormInstance>();
const dirty = ref(false);

watch(
  () => props.model,
  () => {
    dirty.value = true;
  },
  { deep: true },
);

async function handleSubmit(): Promise<void> {
  if (!formRef.value || typeof formRef.value.validate !== 'function') {
    emit('submit');
    return;
  }
  const valid = await formRef.value.validate().catch(() => false);
  if (valid) {
    emit('submit');
  }
}
</script>

<template>
  <div class="app-form" :class="{ 'app-form--compact': compact, 'app-form--two-col': twoColumn }" data-testid="app-form">
    <el-alert
      v-if="error"
      type="error"
      :title="error"
      show-icon
      :closable="false"
      class="app-form-error"
      data-testid="app-form-error"
    />
    <el-form
      ref="formRef"
      :model="model"
      :rules="rules"
      :label-width="labelWidth"
      class="app-form-body"
    >
      <slot />
    </el-form>
    <div class="app-form-footer">
      <el-button :disabled="submitting" @click="emit('cancel')">{{ cancelText }}</el-button>
      <el-button type="primary" :loading="submitting" data-testid="app-form-submit" @click="handleSubmit">
        {{ submitText }}
      </el-button>
    </div>
  </div>
</template>

