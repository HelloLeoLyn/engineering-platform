#!/usr/bin/env bash
# dev-start.sh (generated by engineering-platform runtime-recipe asset)
# Standard Runtime Recipe: start backend and/or frontend for the generated app.
#
# Usage:
#   ./scripts/dev-start.sh            # start backend + frontend
#   ./scripts/dev-start.sh --backend  # backend only
#   ./scripts/dev-start.sh --frontend # frontend only
#
# Port policy:
#   - BACKEND_PORT / FRONTEND_PORT are preferred ports (defaults 8080 / 5173).
#   - If the preferred port is occupied, an available port is allocated
#     automatically (never kills existing processes, never guesses owners).
#   - The ACTUAL ports/URLs are written to .runtime/*.state machine-readable
#     files; dev-status.sh and Browser E2E read from there.
#   - BACKEND_PORT=0 / FRONTEND_PORT=0 forces full auto-allocation.
#
# Backend: mvn package -> runnable boot jar -> java -jar --spring.profiles.active=e2e
# Frontend: pnpm install -> vite dev (strictPort, proxies /api to backend URL
# from .runtime/backend.url — never hardcoded).
set -eo pipefail

# NOTE: no brace-parameter bash syntax in this file — the platform template
# renderer treats brace-params as placeholders. Use $VAR + explicit defaults.
ROOT_DIR="$(cd "$(dirname "$BASH_SOURCE[0]")/.." && pwd)"
RUNTIME_DIR="$ROOT_DIR/.runtime"
mkdir -p "$RUNTIME_DIR"

log() { echo "[dev-start] $*"; }
fail() { echo "[dev-start] ERROR: $*" >&2; exit 1; }

# ---- port allocation (python3 bind probe; no lsof/ss dependency) ----
allocate_port() {
  local preferred="$1"
  python3 - "$preferred" <<'PYEOF'
import socket, sys
pref = int(sys.argv[1])
start = pref if pref > 0 else 8000
for port in range(start, start + 200):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        try:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind(('127.0.0.1', port))
            print(port)
            sys.exit(0)
        except OSError:
            continue
sys.exit(1)
PYEOF
}

is_ready_url() {
  local url="$1"
  curl -fsS -m 2 "$url" >/dev/null 2>&1
}

is_pid_alive() {
  local pid_file="$1"
  [[ -f "$pid_file" ]] && kill -0 "$(cat "$pid_file")" 2>/dev/null
}

start_backend() {
  local pid_file="$RUNTIME_DIR/backend.pid"
  if is_pid_alive "$pid_file"; then
    log "backend already running (pid $(cat "$pid_file")). Use ./scripts/dev-stop.sh first to restart."
    return 0
  fi

  local pref="${BACKEND_PORT:-8080}"
  local port
  port="$(allocate_port "$pref")" || fail "no free port found near $pref"
  local health_url="http://localhost:$port/api/health"
  local base_url="http://localhost:$port"

  # persist machine-readable runtime state (actual port/url)
  echo "$port" > "$RUNTIME_DIR/backend.port"
  echo "$base_url" > "$RUNTIME_DIR/backend.url"
  rm -f "$pid_file"

  log "building backend (mvn package)..."
  if [[ -n "${MAVEN_SETTINGS:-}" ]]; then
    mvn -s "$MAVEN_SETTINGS" -B -f "$ROOT_DIR/pom.xml" package -DskipTests >/dev/null 2>&1 \
      || fail "mvn package failed — see $ROOT_DIR/target for build output"
  else
    mvn -B -f "$ROOT_DIR/pom.xml" package -DskipTests >/dev/null 2>&1 \
      || fail "mvn package failed — see $ROOT_DIR/target for build output"
  fi

  local jar
  jar="$(find "$ROOT_DIR/target" -maxdepth 1 -name '*.jar' ! -name '*.original' | head -1)"
  [[ -n "$jar" ]] || fail "no runnable jar found in target/ — check spring-boot-maven-plugin repackage"

  log "starting backend: $jar (profile=e2e, port=$port)"
  AUTH_TOKEN_SECRET="${AUTH_TOKEN_SECRET:-dev-e2e-secret-key-0123456789abcdef}"
  export AUTH_TOKEN_SECRET
  setsid nohup java -jar "$jar" \
    --spring.profiles.active=e2e \
    --server.port="$port" \
    > "$RUNTIME_DIR/backend.log" 2>&1 &
  echo $! > "$pid_file"
  log "backend pid $(cat "$pid_file") port $port — waiting for readiness"

  local attempts=0
  until is_ready_url "$health_url"; do
    attempts=$((attempts + 1))
    if [[ $attempts -gt 60 ]]; then
      log "backend failed to become ready. Last log lines:"
      tail -20 "$RUNTIME_DIR/backend.log" >&2 || true
      fail "backend readiness timeout ($health_url)"
    fi
    sleep 1
  done
  log "backend READY at $health_url"
}

start_frontend() {
  local pid_file="$RUNTIME_DIR/frontend.pid"
  if is_pid_alive "$pid_file"; then
    log "frontend already running (pid $(cat "$pid_file")). Use ./scripts/dev-stop.sh first to restart."
    return 0
  fi

  # backend URL comes from runtime state (written by start_backend) — never hardcoded
  local backend_url
  backend_url="$(cat "$RUNTIME_DIR/backend.url" 2>/dev/null || true)"
  if [[ -z "$backend_url" ]]; then
    backend_url="${VITE_BACKEND_URL:-http://localhost:8080}"
  fi

  local pref="${FRONTEND_PORT:-5173}"
  local port
  port="$(allocate_port "$pref")" || fail "no free port found near $pref"
  local base_url="http://localhost:$port"

  echo "$port" > "$RUNTIME_DIR/frontend.port"
  echo "$base_url" > "$RUNTIME_DIR/frontend.url"
  rm -f "$pid_file"

  log "installing frontend dependencies (pnpm install)..."
  if [[ -f "$ROOT_DIR/frontend/pnpm-lock.yaml" ]]; then
    (cd "$ROOT_DIR/frontend" && pnpm install --frozen-lockfile) >/dev/null 2>&1 \
      || fail "pnpm install --frozen-lockfile failed"
  else
    # first install on a fresh generated project: lockfile does not exist yet
    (cd "$ROOT_DIR/frontend" && pnpm install) >/dev/null 2>&1 \
      || fail "pnpm install failed"
  fi

  log "starting frontend dev server (vite, port=$port, backend=$backend_url)"
  export VITE_BACKEND_URL="$backend_url"
  setsid nohup pnpm --dir "$ROOT_DIR/frontend" dev --port "$port" --strictPort \
    > "$RUNTIME_DIR/frontend.log" 2>&1 &
  echo $! > "$pid_file"
  log "frontend pid $(cat "$pid_file") port $port"

  local attempts=0
  until is_ready_url "$base_url/"; do
    attempts=$((attempts + 1))
    if [[ $attempts -gt 30 ]]; then
      tail -20 "$RUNTIME_DIR/frontend.log" >&2 || true
      fail "frontend readiness timeout ($base_url)"
    fi
    sleep 1
  done
  log "frontend READY at $base_url (proxying /api -> $backend_url)"
}

main() {
  local target="$1"
  [[ -n "$target" ]] || target="all"
  case "$target" in
    --backend) start_backend ;;
    --frontend) start_frontend ;;
    all) start_backend; start_frontend ;;
    *) fail "unknown target: $target (use --backend | --frontend | all)" ;;
  esac
  log "done."
}

main "$@"
