package com.acme.core.infrastructure.persistence;

import com.acme.core.application.supplier.SupplierPort;
import com.acme.core.application.datascope.DataPermissionContext;
import com.acme.core.application.organization.DepartmentPort;
import com.acme.core.common.core.PageQuery;
import com.acme.core.common.core.PageResult;
import com.acme.core.common.security.DataScope;
import com.acme.core.domain.entity.Supplier;
import com.acme.core.infrastructure.persistence.mapper.SupplierMapper;
import com.baomidou.mybatisplus.core.conditions.query.QueryWrapper;

import java.util.List;
import java.util.Optional;
import java.util.Set;

/**
 * MyBatis-Plus implementation of {@link SupplierPort} (generated by engineering-platform Generic Module Generator).
 * Data scope enforcement happens HERE at the query boundary: ALL / DEPARTMENT /
 * DEPARTMENT_AND_CHILDREN / SELF. Fail-safe: missing department with a department-
 * dependent scope denies (empty), never upgrades to ALL.
 */
public class MybatisSupplierRepository implements SupplierPort {

    private final SupplierMapper supplierMapper;
    private final DepartmentPort departmentPort;

    public MybatisSupplierRepository(SupplierMapper supplierMapper, DepartmentPort departmentPort) {
        this.supplierMapper = supplierMapper;
        this.departmentPort = departmentPort;
    }

    @Override
    public Optional<Supplier> findById(Long id) {
        return Optional.ofNullable(supplierMapper.selectById(id));
    }

    @Override
    public Optional<Supplier> findByIdInScope(Long id, DataPermissionContext context) {
        return findByScope(context).stream().filter(e -> e.getId().equals(id)).findFirst();
    }

    @Override
    public List<Supplier> findByScope(DataPermissionContext context) {
        QueryWrapper<Supplier> wrapper = scopeWrapper(context);
        wrapper.orderByAsc("id");
        return supplierMapper.selectList(wrapper);
    }

    @Override
    public PageResult<Supplier> findPageByScope(DataPermissionContext context, PageQuery query) {
        QueryWrapper<Supplier> countWrapper = scopeWrapper(context);
        long total = supplierMapper.selectCount(countWrapper);
        QueryWrapper<Supplier> pageWrapper = scopeWrapper(context);
        pageWrapper.orderByAsc("id");
        pageWrapper.last("LIMIT " + query.size() + " OFFSET " + query.offset());
        List<Supplier> items = supplierMapper.selectList(pageWrapper);
        return PageResult.of(items, total, query.page(), query.size());
    }

    @Override
    public PageResult<Supplier> findPageByScopeFiltered(DataPermissionContext context, PageQuery query, String keyword, String status) {
        QueryWrapper<Supplier> countWrapper = scopeWrapper(context);
        applyFilters(countWrapper, keyword, status);
        long total = supplierMapper.selectCount(countWrapper);
        QueryWrapper<Supplier> pageWrapper = scopeWrapper(context);
        applyFilters(pageWrapper, keyword, status);
        pageWrapper.orderByAsc("id");
        pageWrapper.last("LIMIT " + query.size() + " OFFSET " + query.offset());
        List<Supplier> items = supplierMapper.selectList(pageWrapper);
        return PageResult.of(items, total, query.page(), query.size());
    }

    private void applyFilters(QueryWrapper<Supplier> wrapper, String keyword, String status) {
        if (keyword != null && !keyword.isBlank()) {
            wrapper.and(w -> {w.like("code", keyword) .or().like("name", keyword) .or().like("status", keyword) .or().like("category", keyword); });
        }
        if (status != null && !status.isBlank()) {
            wrapper.eq("status", status);
        }
    }

    private QueryWrapper<Supplier> scopeWrapper(DataPermissionContext context) {
        QueryWrapper<Supplier> wrapper = new QueryWrapper<>();
        DataScope scope = context.scope() == null ? DataScope.SELF : context.scope();
        switch (scope) {
            case ALL -> { }
            case DEPARTMENT -> {
                if (context.departmentId() == null) { wrapper.eq("id", -1L); } else { wrapper.eq("department_id", context.departmentId()); }
            }
            case DEPARTMENT_AND_CHILDREN -> {
                if (context.departmentId() == null) { wrapper.eq("id", -1L); } else {
                    Set<Long> ids = departmentPort.descendantIds(context.departmentId());
                    ids.add(context.departmentId());
                    wrapper.in("department_id", ids);
                }
            }
            case SELF -> {
                if (context.userId() == null) { wrapper.eq("id", -1L); } else { wrapper.eq("created_by", String.valueOf(context.userId())); }
            }
        }
        return wrapper;
    }

    @Override
    public boolean existsByUnique(String value, Long excludeId) {
        QueryWrapper<Supplier> wrapper = new QueryWrapper<>();
        wrapper.eq("code", value);
        if (excludeId != null) { wrapper.ne("id", excludeId); }
        return supplierMapper.selectCount(wrapper) > 0;
    }

    @Override
    public Supplier insert(Supplier entity) {
        supplierMapper.insert(entity);
        return entity;
    }

    @Override
    public int update(Supplier entity) {
        return supplierMapper.updateById(entity);
    }
}
