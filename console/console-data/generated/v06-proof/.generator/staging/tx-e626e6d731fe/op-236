package com.acme.core.infrastructure.persistence;

import com.acme.core.application.supplier.SupplierPort;
import com.acme.core.application.supplier.SupplierService;
import com.acme.core.application.organization.DepartmentPort;
import com.acme.core.application.dictionary.DictionaryPort;
import com.acme.core.infrastructure.persistence.mapper.SupplierMapper;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

/**
 * Supplier bean wiring (generated by engineering-platform Generic Module Generator).
 */
@Configuration
public class SupplierBeansConfig {

    @Bean
    public SupplierPort supplierPort(SupplierMapper mapper, DepartmentPort departmentPort) {
        return new MybatisSupplierRepository(mapper, departmentPort);
    }

    @Bean
    public SupplierService supplierService(SupplierPort port, DictionaryPort dictionaryPort) {
        return new SupplierService(port, dictionaryPort);
    }
}
