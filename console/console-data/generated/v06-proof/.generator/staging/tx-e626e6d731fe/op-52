/**
 * User management write/read contract (generated by engineering-platform 0.1.0).
 *
 * Stable application-level management contract. The implementation lives in the
 * infrastructure layer (MyBatis-Plus); application/business code depends only
 * on this interface — never on MyBatis persistence types.
 *
 * Transaction semantics belong to the application service that orchestrates
 * these operations (e.g. create + role assignment is one unit of work).
 */
public interface UserManagementPort {

    PageResult<SysUser> page(PageQuery query, String usernameKeyword, Boolean enabled, Long departmentId);

    Optional<SysUser> findById(Long userId);

    Optional<SysUser> findByUsername(String username);

    /** True when a user with the username exists (excluding {@code excludeUserId} when non-null). */
    boolean usernameExists(String username, Long excludeUserId);

    void insert(SysUser user);

    void update(SysUser user);

    /** Role ids currently assigned to the user (stable order). */
    List<Long> roleIdsOf(Long userId);

    /** Replace all roles of the user with the given ids (delete + insert). */
    void replaceUserRoles(Long userId, List<Long> roleIds);

    Optional<SysRole> findRoleById(Long roleId);
}
