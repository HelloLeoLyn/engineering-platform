#!/usr/bin/env bash
# dev-status.sh (generated by engineering-platform runtime-recipe asset)
# Readiness + process status from .runtime state (actual ports, pids).
set -eo pipefail

ROOT_DIR="$(cd "$(dirname "$BASH_SOURCE[0]")/.." && pwd)"
RUNTIME_DIR="$ROOT_DIR/.runtime"

read_state() {
  local name="$1"
  local file="$RUNTIME_DIR/$name"
  if [[ -f "$file" ]]; then
    cat "$file"
  else
    echo ""
  fi
}

backend_pid="$(read_state backend.pid)"
backend_port="$(read_state backend.port)"
backend_url="$(read_state backend.url)"
frontend_pid="$(read_state frontend.pid)"
frontend_port="$(read_state frontend.port)"
frontend_url="$(read_state frontend.url)"

check_one() {
  local name="$1" pid="$2" port="$3" url="$4"
  local status="STOPPED"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    if [[ -n "$url" ]] && curl -fsS -m 2 "$url" >/dev/null 2>&1; then
      status="RUNNING READY"
    else
      status="RUNNING NOT-READY"
    fi
  elif [[ -n "$pid" ]]; then
    status="STALE (pid file present, process gone — run dev-stop.sh)"
  fi
  echo "$name: pid=$pid port=$port status=$status url=$url"
}

check_one "backend" "$backend_pid" "$backend_port" "$backend_url/api/health"
check_one "frontend" "$frontend_pid" "$frontend_port" "$frontend_url/"
