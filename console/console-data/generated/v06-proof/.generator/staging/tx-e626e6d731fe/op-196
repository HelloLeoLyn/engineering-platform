// User Management view tests (generated by engineering-platform frontend-enterprise-management asset)
import { describe, it, expect, vi, beforeEach } from 'vitest';
import { mount, flushPromises } from '@vue/test-utils';
import { createPinia, setActivePinia } from 'pinia';
import { useAuthStore } from '../src/stores/auth';
import UserManagementView from '../src/views/system/UserManagementView.vue';
import { userApi, roleApi, departmentApi } from '../src/api/enterprise';
import type { User } from '../src/types/enterprise';
import { epStubs, platformStubs } from './stubs';

const user: User = {
  id: '10',
  username: 'alice',
  enabled: true,
  departmentId: '1',
  roleIds: ['1'],
  createdAt: '2026-08-15T00:00:00',
};

const stubs = { ...epStubs(), ...platformStubs() };

async function mountView(permissions: string[]): Promise<ReturnType<typeof mount>> {
  const pinia = createPinia();
  setActivePinia(pinia);
  const auth = useAuthStore(pinia);
  auth.$patch({ currentUser: { id: '1', username: 'u', departmentId: null, permissions } });

  vi.spyOn(userApi, 'page').mockResolvedValue({ items: [user], total: 1, page: 1, size: 20 });
  vi.spyOn(roleApi, 'page').mockResolvedValue({ items: [{ id: '1', code: 'admin', name: 'Admin', enabled: true, dataScope: 'ALL', permissionIds: [], createdAt: '' }], total: 1, page: 1, size: 100 });
  vi.spyOn(departmentApi, 'tree').mockResolvedValue([
    { department: { id: '1', parentId: null, code: 'HQ', name: 'HQ', enabled: true, sort: 1, createdAt: '', updatedAt: '' }, children: [] },
  ]);

  return mount(UserManagementView, { global: { plugins: [pinia], stubs } });
}

describe('UserManagementView', () => {
  beforeEach(() => {
    vi.restoreAllMocks();
    localStorage.clear();
  });

  it('loads and renders the user list', async () => {
    const wrapper = await mountView(['system:user:read', 'system:user:create']);
    await flushPromises();
    expect(userApi.page).toHaveBeenCalled();
    expect(wrapper.find('[data-testid="create-user"]').exists()).toBe(true);
  });

  it('create button hidden without system:user:create (read-only user)', async () => {
    const wrapper = await mountView(['system:user:read']);
    await flushPromises();
    expect(wrapper.find('[data-testid="create-user"]').exists()).toBe(false);
  });

  it('renders page container and loads options', async () => {
    await mountView(['system:user:read']);
    await flushPromises();
    expect(roleApi.page).toHaveBeenCalled();
    expect(departmentApi.tree).toHaveBeenCalled();
  });
});
