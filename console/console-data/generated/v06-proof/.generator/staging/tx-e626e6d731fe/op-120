package com.acme.core.infrastructure.persistence;

import com.acme.core.application.dictionary.DictionaryManagementPort;
import com.acme.core.application.dictionary.DictionaryManagementService;
import com.acme.core.application.dictionary.DictionaryPort;
import com.acme.core.application.dictionary.DictionaryService;
import com.acme.core.infrastructure.persistence.mapper.DictionaryItemMapper;
import com.acme.core.infrastructure.persistence.mapper.DictionaryTypeMapper;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

/**
 * Dictionary bean wiring (generated by engineering-platform 0.1.0).
 * MyBatis implementations are wired as the stable application contracts
 * (DictionaryPort / DictionaryManagementPort); application services depend only
 * on those contracts.
 */
@Configuration
public class DictionaryBeansConfig {

    @Bean
    public DictionaryPort dictionaryPort(DictionaryTypeMapper typeMapper,
                                         DictionaryItemMapper itemMapper) {
        return new MybatisDictionaryRepository(typeMapper, itemMapper);
    }

    @Bean
    public DictionaryService dictionaryService(DictionaryPort dictionaryPort) {
        return new DictionaryService(dictionaryPort);
    }

    @Bean
    public DictionaryManagementPort dictionaryManagementPort(DictionaryTypeMapper typeMapper,
                                                             DictionaryItemMapper itemMapper) {
        return new MybatisDictionaryManagementRepository(typeMapper, itemMapper);
    }

    @Bean
    public DictionaryManagementService dictionaryManagementService(
            DictionaryManagementPort dictionaryManagementPort) {
        return new DictionaryManagementService(dictionaryManagementPort);
    }
}
