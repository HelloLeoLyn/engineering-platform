package com.acme.core.common.security;

/**
 * Data scope V1 (generated by engineering-platform 0.1.0).
 *
 * ALL                    → no data restriction
 * DEPARTMENT            → current user's department only
 * DEPARTMENT_AND_CHILDREN → current department + all descendants
 * SELF                  → data created by the current user only
 */
public enum DataScope {

    ALL("ALL"),
    DEPARTMENT("DEPARTMENT"),
    DEPARTMENT_AND_CHILDREN("DEPARTMENT_AND_CHILDREN"),
    SELF("SELF");

    private final String code;

    DataScope(String code) {
        this.code = code;
    }

    public String code() {
        return code;
    }

    public static DataScope fromCode(String code) {
        if (code == null) {
            return null;
        }
        for (DataScope scope : values()) {
            if (scope.code.equals(code)) {
                return scope;
            }
        }
        return null;
    }
}
