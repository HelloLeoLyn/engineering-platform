// Router (generated by engineering-platform frontend-auth asset)
// Controlled route registry: backend menu.path must match allowed routes here.
// Backend menu NEVER loads arbitrary frontend components.
// Enterprise management routes are contributed by frontend-enterprise-management
// (src/router/enterprise.ts).
// Business module routes are contributed by ANY module that drops a route file
// into src/router/business/*.ts exporting `businessRoutes` — reference assets
// (product/supplier) and Generic Module Generator output both use this channel,
// so frontend-auth NEVER hardcodes a business domain name (V06-WORK-002B).
import { createRouter, createWebHistory } from 'vue-router';
import { setupAuthGuard } from './guard';
import { enterpriseRoutes } from './enterprise';
import type { RouteRecordRaw } from 'vue-router';

// Generic business-module route aggregation: glob matches only files that
// exist, so projects without any business module keep compiling. Vite
// normalizes glob keys relative to the importing file (./business/*.ts).
const businessModules = import.meta.glob('../router/business/*.ts', { eager: true }) as Record<
  string,
  { businessRoutes?: RouteRecordRaw[] }
>;
const businessRoutes: RouteRecordRaw[] = Object.values(businessModules).flatMap(
  (m) => m.businessRoutes ?? [],
);

const router = createRouter({
  history: createWebHistory(),
  routes: [
    {
      path: '/login',
      name: 'login',
      component: () => import('../views/LoginView.vue'),
      meta: { public: true },
    },
    {
      path: '/',
      component: () => import('../layouts/AppLayout.vue'),
      children: [
        {
          path: '',
          name: 'home',
          component: () => import('../views/HomeView.vue'),
          meta: { title: 'Home' },
        },
        ...enterpriseRoutes,
        ...businessRoutes,
      ],
    },
    { path: '/403', name: 'forbidden', component: () => import('../views/ForbiddenView.vue'), meta: { public: true } },
    { path: '/404', name: 'not-found', component: () => import('../views/NotFoundView.vue'), meta: { public: true } },
    { path: '/:pathMatch(.*)*', redirect: '/404' },
  ],
});

setupAuthGuard(router);

export default router;
