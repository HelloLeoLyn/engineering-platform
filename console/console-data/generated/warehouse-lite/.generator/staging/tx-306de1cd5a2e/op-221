// WarehouseLite route registration (generated by engineering-platform Generic Module Generator)
// Route module must be picked up by the frontend-auth router via business/*.ts glob.
import { describe, it, expect } from 'vitest';
import { businessRoutes } from '../src/router/business/warehouse-lite';

describe('warehouse-lite routes', () => {
  it('registers list/detail/edit routes with permission meta', () => {
    const paths = businessRoutes.map((r) => r.path);
    expect(paths).toContain('/warehouse-lite');
    const list = businessRoutes.find((r) => r.path === '/warehouse-lite')!;
    expect(list.meta).toMatchObject({ permission: 'warehouse_lite:item:read' });
  });

  it('routes are static imports (no dynamic component from backend path)', () => {
    for (const r of businessRoutes) { expect(typeof r.component).toBe('function'); }
  });
});
