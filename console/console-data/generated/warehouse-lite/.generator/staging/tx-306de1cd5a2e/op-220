import { describe, it, expect, vi, beforeEach } from 'vitest';
import { http } from '../src/api/request';
import { warehouseLiteApi } from '../src/api/warehouse-lite';
import type { WarehouseLite } from '../src/types/warehouse-lite';

const row: WarehouseLite = { id: '1', code: 'v', name: 'v', address: 'v', manager: 'v', status: 'v', departmentId: '1', createdBy: '1', createdAt: '2026-08-16T00:00:00', updatedAt: '2026-08-16T00:00:00' };

describe('warehouseLiteApi', () => {
  beforeEach(() => { vi.restoreAllMocks(); });

  it('page builds query string', async () => {
    const spy = vi.spyOn(http, 'get').mockResolvedValue({ items: [row], total: 1, page: 1, size: 20 });
    await warehouseLiteApi.page({ page: 1, size: 20, keyword: 'x' });
    const [path] = spy.mock.calls[0] as [string];
    expect(path).toContain('page=1');
    expect(path).toContain('keyword=x');
  });

  it('detail/create/update/disable route to the right paths', async () => {
    const get = vi.spyOn(http, 'get').mockResolvedValue(row);
    const post = vi.spyOn(http, 'post').mockResolvedValue(row);
    const put = vi.spyOn(http, 'put').mockResolvedValue(row);
    await warehouseLiteApi.detail('5');
    expect((get.mock.calls[0] as [string])[0]).toBe('/warehouse_lite/5');
    await warehouseLiteApi.create({ id: '0' } as never);
    expect((post.mock.calls[0] as [string])[0]).toBe('/warehouse_lite');
    await warehouseLiteApi.update('5', { id: '0' } as never);
    expect((put.mock.calls[0] as [string])[0]).toBe('/warehouse_lite/5');
    await warehouseLiteApi.disable('5');
    expect((post.mock.calls[1] as [string])[0]).toBe('/warehouse_lite/5/disable');
  });
});
