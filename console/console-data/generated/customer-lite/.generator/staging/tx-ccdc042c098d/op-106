package com.acme.core;

import com.acme.core.application.menu.MenuService;
import com.acme.core.domain.entity.SysMenu;
import org.junit.jupiter.api.Test;

import java.util.List;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;

/**
 * Menu model unit tests (generated by engineering-platform 0.1.0).
 *
 * Covers: tree building, stable ordering, disabled filtering,
 * self-parent reject, cycle reject, invalid parent tolerance.
 */
class MenuModelUnitTest {

    /** In-memory MenuPort stub returning the given menus (stable input order). */
    private static MenuService serviceWith(java.util.List<SysMenu> menus) {
        return new MenuService(() -> menus, null);
    }

    private static SysMenu menu(Long id, Long parentId, String code, String type,
                                String permissionCode, boolean enabled, int sort) {
        SysMenu m = new SysMenu();
        m.setId(id);
        m.setParentId(parentId);
        m.setCode(code);
        m.setName(code);
        m.setType(type);
        m.setPermissionCode(permissionCode);
        m.setEnabled(enabled);
        m.setSort(sort);
        return m;
    }

    // tree: root first, siblings stable by sort, children nested
    @Test
    void treeBuildsStableHierarchy() {
        MenuService service = serviceWith(List.of(
                menu(2L, 1L, "child", "MENU", null, true, 1),
                menu(1L, null, "root", "DIRECTORY", null, true, 1),
                menu(3L, 1L, "child2", "MENU", null, true, 2)));
        List<MenuService.MenuNode> tree = service.tree();
        assertThat(tree).hasSize(1);
        assertThat(tree.get(0).menu().getCode()).isEqualTo("root");
        assertThat(tree.get(0).children()).hasSize(2);
        assertThat(tree.get(0).children().get(0).menu().getCode()).isEqualTo("child");
        assertThat(tree.get(0).children().get(1).menu().getCode()).isEqualTo("child2");
    }

    // disabled menu must be excluded from the tree
    @Test
    void disabledMenuExcludedFromTree() {
        MenuService service = serviceWith(List.of(
                menu(1L, null, "root", "DIRECTORY", null, true, 1),
                menu(2L, 1L, "gone", "MENU", null, false, 1)));
        List<MenuService.MenuNode> tree = service.tree();
        assertThat(tree.get(0).children()).isEmpty();
    }

    // self-parent must be rejected (tree() runs validateStructure internally)
    @Test
    void selfParentRejected() {
        MenuService service = serviceWith(List.of(
                menu(1L, 1L, "self", "MENU", null, true, 1)));
        assertThatThrownBy(service::tree)
                .isInstanceOfSatisfying(
                        com.acme.core.common.core.PlatformException.class,
                        e -> assertThat(e.errorCode().code()).isEqualTo("MENU_SELF_PARENT"));
    }

    // cycle must be rejected (tree() runs validateStructure internally)
    @Test
    void cycleRejected() {
        MenuService service = serviceWith(List.of(
                menu(1L, 2L, "a", "MENU", null, true, 1),
                menu(2L, 1L, "b", "MENU", null, true, 2)));
        assertThatThrownBy(service::tree)
                .isInstanceOfSatisfying(
                        com.acme.core.common.core.PlatformException.class,
                        e -> assertThat(e.errorCode().code()).isEqualTo("MENU_CYCLE"));
    }

    // invalid parent (missing parent node) is tolerated: node becomes a root
    @Test
    void invalidParentTreatedAsRoot() {
        MenuService service = serviceWith(List.of(
                menu(1L, 999L, "orphan", "MENU", null, true, 1)));
        List<MenuService.MenuNode> tree = service.tree();
        assertThat(tree).hasSize(1);
        assertThat(tree.get(0).menu().getCode()).isEqualTo("orphan");
    }

    // permission filtering: leaf without permission always visible for anyone
    // (deep filtering is covered by real RBAC in MenuE2ETest; here we verify container pruning)
    @Test
    void treeDoesNotCrashWithoutUserQueryPort() {
        MenuService service = serviceWith(List.of(
                menu(1L, null, "root", "DIRECTORY", null, true, 1)));
        List<MenuService.MenuNode> tree = service.tree();
        assertThat(tree).hasSize(1);
    }
}
