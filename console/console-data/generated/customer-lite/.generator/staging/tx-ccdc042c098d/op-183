    </div>
    <div class="stat-card-body">
      <p class="stat-card-label">{{ label }}</p>
      <p class="stat-card-value">{{ value }}</p>
      <p v-if="delta" class="stat-card-delta" :class="deltaClass">{{ delta }}</p>
    </div>
  </div>
</template>

