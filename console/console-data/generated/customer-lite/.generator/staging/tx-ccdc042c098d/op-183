<script setup lang="ts">
// StatCard (generated by engineering-platform frontend-enterprise-management asset)
// V06-WORK-003B EP UI 2.0 (Visual Refinement): colorful KPI card with 3 layers —
// accent icon surface / metric (visual focus) / context + trend delta.
// Zero external icon dependency (unicode markers only).
import { computed } from 'vue';

const props = withDefaults(
  defineProps<{
    label: string;
    value: string | number;
    /** Optional delta text (e.g. "+12% vs last week"); neutral when empty. */
    delta?: string;
    deltaTone?: 'up' | 'down' | 'neutral';
    /** Accent key: indigo | violet | cyan | sky | emerald | amber | rose | orange */
    accent?: string;
    /** Optional 1-2 char marker shown in the tinted block. */
    marker?: string;
  }>(),
  {
    delta: '',
    deltaTone: 'neutral',
    accent: 'indigo',
    marker: '',
  },
);

const accentClass = computed(() => 'accent-' + props.accent);
const deltaClass = computed(() => 'delta-' + props.deltaTone);
const markerText = computed(() => props.marker || props.label.charAt(0).toUpperCase());
</script>

