/* ============================================================
 * EP Design System Tokens (generated by engineering-platform frontend-auth asset)
 * V06-WORK-003B — Enterprise Admin Visual Refinement
 *
 * Design language: Modern Enterprise SaaS + Colorful Dashboard + Clean ERP Workspace
 *   - very light neutral / lavender / cool-gray canvas (never near-white)
 *   - primary surface: white; secondary/tinted: light colored surfaces
 *   - major cards 14-18px radius; controls/buttons 8-12px; badges pill
 *   - very soft multi-layer shadows; NO heavy Material shadows
 *   - borders heavily weakened; card hierarchy via bg / spacing / shadow
 *   - 4/8 base spacing rhythm; page module gaps > intra-component gaps
 *   - explicit typography scale incl. metric (KPI numbers are the focus)
 *   - limited semantic accent palette (primary/info/success/warning/danger/purple)
 *   - Dashboard ~30-40% colorful; CRUD ~10-15% colorful, calm & dense
 *
 * Naming convention: --ep-<group>-<semantic>[-<variant>]
 * Legacy V0.5 aliases are preserved at the bottom for backward compatibility.
 * ============================================================ */
:root {
  /* ---- color: neutrals (very light lavender / cool-gray canvas) ---- */
  --ep-color-canvas: #f4f5fa;            /* app background — soft lavender gray */
  --ep-color-canvas-deep: #eceef6;       /* sidebar / wells */
  --ep-color-surface: #ffffff;           /* primary surface: cards / panels */
  --ep-color-surface-muted: #f8f9fc;     /* subtle inset surfaces */
  --ep-color-surface-tinted: #f1f3fa;    /* secondary/tinted surface (lavender) */
  --ep-color-surface-hover: #f3f4fa;     /* hover fills */
  --ep-color-surface-active: #e9ecf7;    /* pressed / selected fills */
  --ep-color-surface-glass: rgba(255, 255, 255, 0.7); /* translucent topbar */

  /* ---- color: text ---- */
  --ep-color-text: #1b2137;              /* primary text */
  --ep-color-text-secondary: #57607d;    /* secondary text */
  --ep-color-text-muted: #8a93ab;        /* captions / placeholders */
  --ep-color-text-inverse: #ffffff;
  --ep-color-text-on-accent: #ffffff;

  /* ---- color: borders (weakened — structural only) ---- */
  --ep-color-border: #e6e9f2;            /* hairline card borders */
  --ep-color-border-strong: #d6dae8;     /* dividers / inputs */
  --ep-color-border-focus: #6366f1;

  /* ---- color: brand / primary (indigo) ---- */
  --ep-color-primary: #6366f1;
  --ep-color-primary-hover: #4f52e8;
  --ep-color-primary-active: #4347d8;
  --ep-color-primary-soft: #eef0fe;
  --ep-color-primary-soft-strong: #e0e3fd;

  /* ---- color: accent palette (semantic, low-saturation, limited) ---- */
  --ep-accent-indigo: #6366f1;   /* primary / purple accent */
  --ep-accent-violet: #8b5cf6;
  --ep-accent-cyan: #06b6d4;     /* info alt */
  --ep-accent-sky: #0ea5e9;      /* info */
  --ep-accent-emerald: #10b981;  /* success */
  --ep-accent-amber: #f59e0b;    /* warning */
  --ep-accent-rose: #f43f5e;     /* danger */
  --ep-accent-orange: #f97316;   /* highlight */

  /* soft fills for charts / KPI icons / tinted surfaces */
  --ep-accent-indigo-soft: #eef0fe;
  --ep-accent-violet-soft: #f5f0ff;
  --ep-accent-cyan-soft: #e8f9fc;
  --ep-accent-sky-soft: #eaf5fe;
  --ep-accent-emerald-soft: #e9faf3;
  --ep-accent-amber-soft: #fdf3e2;
  --ep-accent-rose-soft: #fdeef1;
  --ep-accent-orange-soft: #fef0e7;

  /* ---- color: status (semantic — same semantic, same token) ---- */
  --ep-color-success: #10b981;
  --ep-color-success-soft: #e9faf3;
  --ep-color-warning: #f59e0b;
  --ep-color-warning-soft: #fdf3e2;
  --ep-color-danger: #f43f5e;
  --ep-color-danger-soft: #fdeef1;
  --ep-color-info: #64748b;
  --ep-color-info-soft: #f1f5f9;

  /* ---- typography (explicit scale: page/section/card/body/secondary/caption/metric) ---- */
  --ep-font-family: 'Inter', 'Segoe UI', 'PingFang SC', 'Microsoft YaHei',
    system-ui, -apple-system, sans-serif;
  --ep-font-size-display: 28px;   /* dashboard hero */
  --ep-font-size-page: 22px;      /* page titles */
  --ep-font-size-section: 16px;   /* section titles */
  --ep-font-size-card-title: 15px; /* card titles */
  --ep-font-size-lg: 15px;
  --ep-font-size-base: 14px;      /* body */
  --ep-font-size-sm: 13px;        /* secondary */
  --ep-font-size-xs: 12px;        /* captions */
  --ep-font-size-metric: 30px;    /* KPI metric — visual focus */
  --ep-font-size-metric-sm: 22px; /* compact metrics */
  --ep-font-weight-regular: 400;
  --ep-font-weight-medium: 500;
  --ep-font-weight-semibold: 600;
  --ep-font-weight-bold: 700;
  --ep-line-height-tight: 1.25;
  --ep-line-height-base: 1.55;

  /* ---- spacing (4px base rhythm) ---- */
  --ep-space-0: 0;
  --ep-space-1: 4px;
  --ep-space-2: 8px;
  --ep-space-3: 12px;
  --ep-space-4: 16px;
  --ep-space-5: 24px;
  --ep-space-6: 32px;
  --ep-space-7: 40px;
  --ep-space-8: 48px;

  /* ---- radius (major cards 14-18, controls 8-12, badges pill) ---- */
  --ep-radius-sm: 8px;    /* controls / buttons */
  --ep-radius-base: 10px; /* inputs / small cards */
  --ep-radius-lg: 14px;   /* cards */
  --ep-radius-xl: 18px;   /* major cards / dashboard */
  --ep-radius-pill: 999px;

  /* ---- shadow (very soft, layered — no heavy Material) ---- */
  --ep-shadow-xs: 0 1px 2px rgba(24, 29, 56, 0.04);
  --ep-shadow-sm: 0 1px 2px rgba(24, 29, 56, 0.05), 0 2px 8px rgba(24, 29, 56, 0.04);
  --ep-shadow-base: 0 2px 4px rgba(24, 29, 56, 0.04), 0 6px 18px rgba(24, 29, 56, 0.05);
  --ep-shadow-lg: 0 6px 14px rgba(24, 29, 56, 0.06), 0 14px 32px rgba(24, 29, 56, 0.07);
  --ep-shadow-xl: 0 14px 30px rgba(24, 29, 56, 0.09), 0 24px 56px rgba(24, 29, 56, 0.1);
  --ep-shadow-focus: 0 0 0 3px rgba(99, 102, 241, 0.16);

  /* ---- layout dimensions ---- */
  --ep-sidebar-width: 240px;
  --ep-sidebar-width-collapsed: 72px;
  --ep-header-height: 60px;
  --ep-content-max-width: 1280px;
  --ep-content-padding: 24px;

  /* ---- interaction (lightweight, unified micro-interactions) ---- */
  --ep-transition-fast: 120ms ease;
  --ep-transition-base: 200ms ease;
  --ep-transition-slow: 320ms cubic-bezier(0.22, 1, 0.36, 1);
  --ep-focus-ring: 0 0 0 3px rgba(99, 102, 241, 0.16);
  --ep-state-disabled-opacity: 0.5;
  --ep-state-loading-opacity: 0.7;

  /* ---- misc ---- */
  --ep-blur-glass: blur(12px) saturate(1.4);
  --ep-z-header: 100;
  --ep-z-drawer: 300;

  /* ============================================================
   * V0.5 legacy aliases (backward compatibility)
   * ============================================================ */
  --ep-surface: var(--ep-color-canvas);
  --ep-surface-elevated: var(--ep-color-surface);
  --ep-color-danger: var(--ep-color-danger);
  --ep-color-success: var(--ep-color-success);
  --ep-color-warning: var(--ep-color-warning);
  --ep-color-info: var(--ep-color-info);
  --ep-radius: var(--ep-radius-base);
  --ep-radius-lg: var(--ep-radius-lg);
  --ep-radius-sm: var(--ep-radius-sm);
}

/* ---- element-plus primary theming (indigo) ---- */
:root {
  --el-color-primary: var(--ep-color-primary);
  --el-color-primary-light-3: #8587f5;
  --el-color-primary-light-5: #a5a7f8;
  --el-color-primary-light-7: #c6c7fb;
  --el-color-primary-light-8: #d8d9fc;
  --el-color-primary-light-9: #ececfd;
  --el-color-primary-dark-2: var(--ep-color-primary-active);
  --el-color-success: var(--ep-color-success);
  --el-color-warning: var(--ep-color-warning);
  --el-color-danger: var(--ep-color-danger);
  --el-color-error: var(--ep-color-danger);
  --el-color-info: var(--ep-color-info);
  --el-border-radius-base: var(--ep-radius-sm);
  --el-border-radius-small: 6px;
  --el-font-family: var(--ep-font-family);
}

/* ---- base typography / scrollbars ---- */
body {
  font-family: var(--ep-font-family);
  font-size: var(--ep-font-size-base);
  line-height: var(--ep-line-height-base);
  color: var(--ep-color-text);
  background: var(--ep-color-canvas);
  -webkit-font-smoothing: antialiased;
}

::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
::-webkit-scrollbar-thumb {
  background: #cbd3e1;
  border-radius: var(--ep-radius-pill);
  border: 2px solid transparent;
  background-clip: content-box;
}
::-webkit-scrollbar-track {
  background: transparent;
}
