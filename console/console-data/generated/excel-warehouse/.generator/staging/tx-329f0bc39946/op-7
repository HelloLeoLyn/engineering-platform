package com.acme.core.common.core;

/**
 * Unified API response contract (generated by engineering-platform 0.1.0).
 * Transport-agnostic: HTTP transport details are intentionally NOT part of this contract.
 * Errors are carried via stable {@link ErrorCode} / {@link PlatformException}.
 */
public record ApiResponse<T>(boolean success, T data, ErrorCode error, String message) {

    public static <T> ApiResponse<T> ofSuccess(T data) {
        return new ApiResponse<>(true, data, null, null);
    }

    public static ApiResponse<Void> ofSuccess() {
        return new ApiResponse<>(true, null, null, null);
    }

    public static <T> ApiResponse<T> ofError(ErrorCode error) {
        return new ApiResponse<>(false, null, error, error == null ? null : error.message());
    }

    public static <T> ApiResponse<T> ofError(ErrorCode error, String message) {
        return new ApiResponse<>(false, null, error, message);
    }

    public static <T> ApiResponse<T> ofError(PlatformException ex) {
        ErrorCode code = ex == null ? null : ex.errorCode();
        return new ApiResponse<>(false, null, code, ex == null ? null : ex.getMessage());
    }
}
