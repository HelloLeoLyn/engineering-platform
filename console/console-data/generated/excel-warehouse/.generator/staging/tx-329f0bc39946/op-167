<script setup lang="ts">
// State views (generated by engineering-platform frontend-permission asset)
// UX baseline: unified Loading / Empty / Error / PermissionDenied states.
import { ElButton, ElEmpty, ElResult } from 'element-plus';

defineProps<{
  title?: string;
  description?: string;
  retryable?: boolean;
}>();
const emit = defineEmits<{ retry: [] }>();
</script>

<template>
  <!-- Loading -->
  <div v-if="title === 'loading'" class="state-view" data-testid="loading-state">
    <el-skeleton :rows="4" animated />
  </div>

  <!-- Empty -->
  <el-empty
    v-else-if="title === 'empty'"
    :description="description ?? 'No data'"
    data-testid="empty-state"
  />

  <!-- Error -->
  <el-result
    v-else-if="title === 'error'"
    icon="error"
    :title="description ?? 'Something went wrong'"
    data-testid="error-state"
  >
    <template v-if="retryable" #extra>
      <el-button type="primary" @click="emit('retry')">Retry</el-button>
    </template>
  </el-result>

  <!-- Permission denied -->
  <el-result
    v-else
    icon="warning"
    title="Permission denied"
    :sub-title="description ?? 'You do not have access to this resource'"
    data-testid="permission-denied-state"
  />
</template>

<style scoped>
.state-view {
  padding: var(--ep-space-5) 0;
}
</style>
