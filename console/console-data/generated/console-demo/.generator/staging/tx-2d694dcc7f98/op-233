package com.acme.core.application.supplier;

import com.acme.core.application.datascope.DataPermissionContext;
import com.acme.core.application.dictionary.DictionaryPort;
import com.acme.core.common.core.ErrorCode;
import com.acme.core.common.core.PageQuery;
import com.acme.core.common.core.PageResult;
import com.acme.core.common.core.PlatformException;
import com.acme.core.domain.entity.DictionaryItem;
import com.acme.core.domain.entity.Supplier;

import java.time.LocalDateTime;
import java.util.List;

/**
 * Supplier application service (generated by engineering-platform Generic Module Generator).
 * Client never supplies createdBy/departmentId: they come from the authenticated RequestContext.
 */
public class SupplierService {

    private final SupplierPort supplierPort;
    private final DictionaryPort dictionaryPort;

    public SupplierService(SupplierPort supplierPort, DictionaryPort dictionaryPort) {
        this.supplierPort = supplierPort;
        this.dictionaryPort = dictionaryPort;
    }

    public SupplierResponse create(SupplierCreateRequest request, Long userId, Long departmentId) {
        if (request.code() == null || request.code().isBlank()) {
            throw new PlatformException(ErrorCode.of("SUPPLIER_CODE_REQUIRED", "code is required"));
        }
        if (supplierPort.existsByUnique(String.valueOf(request.code()), null)) {
            throw new PlatformException(ErrorCode.of("SUPPLIER_CODE_DUPLICATE", "code already exists"));
        }
        if (request.name() == null || request.name().isBlank()) {
            throw new PlatformException(ErrorCode.of("SUPPLIER_NAME_REQUIRED", "name is required"));
        }
        validateDictionary("supplier_status", request.status());
        validateDictionary("supplier_category", request.category());
        Supplier supplier = new Supplier();
        supplier.setCode(request.code());
        supplier.setName(request.name());
        supplier.setStatus(request.status());
        supplier.setCategory(request.category());
        supplier.setDepartmentId(departmentId);
        supplier.setCreatedBy(userId);
        LocalDateTime now = LocalDateTime.now();
        supplier.setCreatedAt(now);
        supplier.setUpdatedAt(now);
        supplierPort.insert(supplier);
        return toResponse(supplier);
    }

    public SupplierResponse get(Long id, DataPermissionContext context) {
        Supplier supplier = supplierPort.findByIdInScope(id, context)
                .orElseThrow(() -> new PlatformException(ErrorCode.of("SUPPLIER_NOT_FOUND", "supplier not found: " + id)));
        return toResponse(supplier);
    }

    public List<SupplierResponse> list(DataPermissionContext context) {
        return supplierPort.findByScope(context).stream().map(this::toResponse).toList();
    }

    public PageResult<SupplierResponse> page(PageQuery query, DataPermissionContext context) {
        PageResult<Supplier> result = supplierPort.findPageByScope(context, query);
        List<SupplierResponse> items = result.items().stream().map(this::toResponse).toList();
        return PageResult.of(items, result.total(), result.page(), result.size());
    }

    public PageResult<SupplierResponse> pageFiltered(PageQuery query, DataPermissionContext context, String keyword, String status) {
        PageResult<Supplier> result = supplierPort.findPageByScopeFiltered(context, query, keyword, status);
        List<SupplierResponse> items = result.items().stream().map(this::toResponse).toList();
        return PageResult.of(items, result.total(), result.page(), result.size());
    }

    public SupplierResponse update(Long id, SupplierUpdateRequest request, DataPermissionContext context) {
        Supplier supplier = supplierPort.findByIdInScope(id, context)
                .orElseThrow(() -> new PlatformException(ErrorCode.of("SUPPLIER_NOT_FOUND", "supplier not found: " + id)));
        if (request.code() == null || request.code().isBlank()) {
            throw new PlatformException(ErrorCode.of("SUPPLIER_CODE_REQUIRED", "code is required"));
        }
        if (supplierPort.existsByUnique(String.valueOf(request.code()), id)) {
            throw new PlatformException(ErrorCode.of("SUPPLIER_CODE_DUPLICATE", "code already exists"));
        }
        if (request.name() == null || request.name().isBlank()) {
            throw new PlatformException(ErrorCode.of("SUPPLIER_NAME_REQUIRED", "name is required"));
        }
        validateDictionary("supplier_status", request.status());
        validateDictionary("supplier_category", request.category());
        supplier.setCode(request.code());
        supplier.setName(request.name());
        supplier.setStatus(request.status());
        supplier.setCategory(request.category());
        supplier.setUpdatedAt(LocalDateTime.now());
        supplierPort.update(supplier);
        return toResponse(supplier);
    }

    public SupplierResponse disable(Long id, DataPermissionContext context) {
        Supplier supplier = supplierPort.findByIdInScope(id, context)
                .orElseThrow(() -> new PlatformException(ErrorCode.of("SUPPLIER_NOT_FOUND", "supplier not found: " + id)));
        supplier.setStatus("DISABLED");
        supplier.setUpdatedAt(LocalDateTime.now());
        supplierPort.update(supplier);
        return toResponse(supplier);
    }

    private void validateDictionary(String code, String value) {
        if (value == null || value.isBlank()) return;
        dictionaryPort.findTypeByCode(code).ifPresent(type -> {
            java.util.Set<String> values = dictionaryPort.findItemsByTypeId(type.getId()).stream()
                    .map(DictionaryItem::getValue).collect(java.util.stream.Collectors.toSet());
            if (!values.isEmpty() && !values.contains(value)) {
                throw new PlatformException(ErrorCode.of("SUPPLIER_DICTIONARY_INVALID", "value not in dictionary " + code + ": " + value));
            }
        });
    }

    private SupplierResponse toResponse(Supplier e) {
        return SupplierResponse.of(e.getId(), e.getCode(), e.getName(), e.getStatus(), e.getCategory(), e.getDepartmentId(), e.getCreatedBy(), e.getCreatedAt(), e.getUpdatedAt());
    }
}
