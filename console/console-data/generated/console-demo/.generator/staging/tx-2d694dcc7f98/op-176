// Menu API (generated by engineering-platform frontend-auth asset)
// Dynamic menu source: GET /api/menus/me (backend permission-filtered).
import { http } from './request';

export interface MenuItem {
  id: number;
  parentId: number | null;
  code: string;
  name: string;
  type: string; // DIRECTORY | MENU | ACTION
  path: string | null;
  permissionCode: string | null;
  enabled: boolean;
  sort: number;
}

export interface MenuNode {
  menu: MenuItem;
  children: MenuNode[];
}

export const menuApi = {
  me: () => http.get<MenuNode[]>('/menus/me'),
};
