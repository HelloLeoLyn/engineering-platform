<script setup lang="ts">
// Operation Log (generated by engineering-platform frontend-enterprise-management asset)
// Read-only audit surface: paged query with user/operation/result/time filters.
// Admin-oriented: Time/User/Operation/Resource/Result primary; tracking ids in expand.
import { onMounted, reactive, ref } from 'vue';
import PageHeader from '../../components/PageHeader.vue';
import PageContainer from '../../components/PageContainer.vue';
import SearchForm from '../../components/SearchForm.vue';
import AppTable from '../../components/AppTable.vue';
import { operationLogApi } from '../../api/enterprise';
import type { OperationLog } from '../../types/enterprise';
import { errorMessage } from '../../utils/feedback';

const loading = ref(false);
const error = ref<string | null>(null);
const logs = ref<OperationLog[]>([]);
const total = ref(0);
const page = ref(1);
const size = ref(20);

const filters = reactive({
  userId: '',
  operation: '',
  resourceType: '',
  result: '',
  timeRange: null as [string, string] | null,
});

async function load(): Promise<void> {
  loading.value = true;
  error.value = null;
  try {
    const result = await operationLogApi.page({
      page: page.value,
      size: size.value,
      userId: filters.userId || undefined,
      operation: filters.operation || undefined,
      resourceType: filters.resourceType || undefined,
      result: filters.result || undefined,
      from: filters.timeRange?.[0],
      to: filters.timeRange?.[1],
    });
    logs.value = result.items;
    total.value = result.total;
  } catch (e) {
    error.value = errorMessage(e);
  } finally {
    loading.value = false;
  }
}

function reset(): void {
  filters.userId = '';
  filters.operation = '';
  filters.resourceType = '';
  filters.result = '';
  filters.timeRange = null;
  page.value = 1;
  load();
}

function resultLabel(result: string): string {
  return result.toUpperCase() === 'SUCCESS' ? 'Success' : result;
}

onMounted(load);
</script>

<template>
  <PageContainer full-width>
    <PageHeader title="Operation Log" description="Read-only audit trail of platform operations." />

    <SearchForm more @search="load" @reset="reset">
      <el-input v-model="filters.userId" placeholder="User id" clearable style="width: 140px" data-testid="oplog-filter-user" />
      <el-input v-model="filters.operation" placeholder="Operation" clearable style="width: 180px" data-testid="oplog-filter-operation" />
      <template #more>
        <el-input
          v-model="filters.resourceType"
          placeholder="Resource type"
          clearable
          style="width: 160px"
          data-testid="oplog-filter-resource"
        />
        <el-select v-model="filters.result" placeholder="Result" clearable style="width: 140px" data-testid="oplog-filter-result">
          <el-option label="Success" value="SUCCESS" />
          <el-option label="Failure" value="FAILURE" />
        </el-select>
        <el-date-picker
          v-model="filters.timeRange"
          type="datetimerange"
          start-placeholder="From"
          end-placeholder="To"
          style="width: 360px"
          data-testid="oplog-filter-time"
        />
      </template>
    </SearchForm>

    <AppTable
      :loading="loading"
      :error="error"
      :data="logs"
      :total="total"
      :page="page"
      :size="size"
      @refresh="load"
      @update:page="(p: number) => { page = p; load(); }"
      @update:size="(s: number) => { size = s; page = 1; load(); }"
    >
      <el-table-column label="Time" min-width="170">
        <template #default="{ row }">{{ new Date(row.occurredAt).toLocaleString() }}</template>
      </el-table-column>
      <el-table-column label="User" width="110">
        <template #default="{ row }">{{ row.userId ?? '—' }}</template>
      </el-table-column>
      <el-table-column prop="operation" label="Operation" min-width="180" />
      <el-table-column prop="resourceType" label="Resource" min-width="130" />
      <el-table-column prop="resourceId" label="Resource id" min-width="120">
        <template #default="{ row }">{{ row.resourceId ?? '—' }}</template>
      </el-table-column>
      <el-table-column label="Result" width="110">
        <template #default="{ row }">
          <el-tag :type="row.result === 'SUCCESS' ? 'success' : 'danger'" size="small">
            {{ resultLabel(row.result) }}
          </el-tag>
        </template>
      </el-table-column>
      <el-table-column type="expand" width="40">
        <template #default="{ row }">
          <div class="log-detail" data-testid="oplog-detail">
            <div><strong>Request id:</strong> {{ row.requestId ?? '—' }}</div>
            <div><strong>Correlation id:</strong> {{ row.correlationId ?? '—' }}</div>
            <div><strong>Method:</strong> {{ row.method ?? '—' }}</div>
            <div><strong>Path:</strong> {{ row.path ?? '—' }}</div>
          </div>
        </template>
      </el-table-column>
    </AppTable>
  </PageContainer>
</template>

