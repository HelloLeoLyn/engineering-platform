package com.acme.core.infrastructure.persistence;

import com.acme.core.application.organization.DepartmentManagementPort;
import com.acme.core.application.organization.DepartmentManagementService;
import com.acme.core.application.organization.DepartmentPort;
import com.acme.core.application.organization.DepartmentService;
import com.acme.core.infrastructure.persistence.mapper.SysDepartmentMapper;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

/**
 * Organization bean wiring (generated by engineering-platform 0.1.0).
 * MyBatis implementations are wired as the stable application contracts
 * (DepartmentPort / DepartmentManagementPort); application services depend only
 * on those contracts.
 */
@Configuration
public class OrganizationBeansConfig {

    @Bean
    public DepartmentPort departmentPort(SysDepartmentMapper departmentMapper) {
        return new MybatisDepartmentRepository(departmentMapper);
    }

    @Bean
    public DepartmentService departmentService(DepartmentPort departmentPort) {
        return new DepartmentService(departmentPort);
    }

    @Bean
    public DepartmentManagementPort departmentManagementPort(SysDepartmentMapper departmentMapper) {
        return new MybatisDepartmentManagementRepository(departmentMapper);
    }

    @Bean
    public DepartmentManagementService departmentManagementService(
            DepartmentManagementPort departmentManagementPort, DepartmentService departmentService) {
        return new DepartmentManagementService(departmentManagementPort, departmentService);
    }
}
