package com.acme.core;

import com.acme.core.api.auth.LoginRequest;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.boot.test.web.client.TestRestTemplate;
import org.springframework.boot.test.web.server.LocalServerPort;
import org.springframework.http.HttpEntity;
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpMethod;
import org.springframework.http.HttpStatus;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.test.context.ActiveProfiles;

import java.util.List;
import java.util.Map;

import static org.assertj.core.api.Assertions.assertThat;

/**
 * Real HTTP Product DataScope E2E (generated by engineering-platform 0.1.0).
 *
 * Proves data permission also protects detail/update (not just list):
 *   detail out of scope -> not exposed (PRODUCT_NOT_FOUND)
 *   update out of scope -> denied (PRODUCT_NOT_FOUND)
 *   detail in scope -> OK
 * Seed products: 1=HQ/admin, 2+3=Sales, 4=Sales-East, 5=Finance, 6=self-user.
 */
@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
@ActiveProfiles("test")
class ProductDataScopeE2ETest {

    @LocalServerPort
    private int port;

    @Autowired
    private TestRestTemplate rest;

    private String url(String path) {
        return "http://localhost:" + port + path;
    }

    private ResponseEntity<Map> login(String username, String password) {
        HttpHeaders headers = new HttpHeaders();
        headers.setContentType(MediaType.APPLICATION_JSON);
        HttpEntity<LoginRequest> body = new HttpEntity<>(new LoginRequest(username, password), headers);
        return rest.postForEntity(url("/api/auth/login"), body, Map.class);
    }

    private String token(String username, String password) {
        ResponseEntity<Map> response = login(username, password);
        assertThat(response.getStatusCode()).isEqualTo(HttpStatus.OK);
        Map data = (Map) response.getBody().get("data");
        return (String) data.get("token");
    }

    private HttpEntity<String> json(String token, String body) {
        HttpHeaders headers = new HttpHeaders();
        headers.setContentType(MediaType.APPLICATION_JSON);
        headers.setBearerAuth(token);
        return new HttpEntity<>(body, headers);
    }

    private ResponseEntity<Map> get(String token, String path) {
        HttpHeaders headers = new HttpHeaders();
        headers.setBearerAuth(token);
        return rest.exchange(url(path), HttpMethod.GET, new HttpEntity<>(headers), Map.class);
    }

    // admin (ALL) can read every product detail
    @Test
    void adminReadsAllDetails() {
        String token = token("admin", "admin123");
        for (long id = 1; id <= 6; id++) {
            ResponseEntity<Map> detail = get(token, "/api/products/" + id);
            assertThat(detail.getStatusCode()).isEqualTo(HttpStatus.OK);
        }
    }

    // finance-user (DEPARTMENT, dept 4) can read product 5 but NOT product 2 (Sales)
    @Test
    void departmentUserSeesOwnDetailOnly() {
        String token = token("finance-user", "admin123");
        ResponseEntity<Map> own = get(token, "/api/products/5");
        assertThat(own.getStatusCode()).isEqualTo(HttpStatus.OK);
        ResponseEntity<Map> other = get(token, "/api/products/2");
        assertThat(other.getStatusCode()).isEqualTo(HttpStatus.NOT_FOUND);
        Map error = (Map) other.getBody().get("error");
        assertThat(String.valueOf(error.get("code"))).isEqualTo("PRODUCT_NOT_FOUND");
    }

    // self-user (SELF) can read own product 6 but NOT product 1 (HQ/admin)
    @Test
    void selfUserSeesOwnDetailOnly() {
        String token = token("self-user", "admin123");
        ResponseEntity<Map> own = get(token, "/api/products/6");
        assertThat(own.getStatusCode()).isEqualTo(HttpStatus.OK);
        ResponseEntity<Map> other = get(token, "/api/products/1");
        assertThat(other.getStatusCode()).isEqualTo(HttpStatus.NOT_FOUND);
        Map error = (Map) other.getBody().get("error");
        assertThat(String.valueOf(error.get("code"))).isEqualTo("PRODUCT_NOT_FOUND");
    }

    // update out of scope -> denied (PRODUCT_NOT_FOUND), row unchanged
    // sales-manager has update permission but scope = Sales+Sales-East (2,3);
    // product 5 is Finance (dept 4) -> out of scope
    @Test
    void updateOutOfScopeDenied() {
        String token = token("sales-manager", "admin123");
        ResponseEntity<Map> update = rest.exchange(url("/api/products/5"),
                HttpMethod.PUT, json(token, "{\"code\":\"PRD-005\",\"name\":\"Hacked\"}"), Map.class);
        assertThat(update.getStatusCode()).isEqualTo(HttpStatus.NOT_FOUND);
        Map error = (Map) update.getBody().get("error");
        assertThat(String.valueOf(error.get("code"))).isEqualTo("PRODUCT_NOT_FOUND");
        // product 5 unchanged
        String adminToken = token("admin", "admin123");
        Map detail = (Map) get(adminToken, "/api/products/5").getBody().get("data");
        assertThat(detail.get("name")).isEqualTo("P-FINANCE-1");
    }

    // disable out of scope -> denied (finance-user has disable permission but
    // scope = Finance (dept 4); product 2 is Sales -> out of scope)
    @Test
    void disableOutOfScopeDenied() {
        String token = token("finance-user", "admin123");
        ResponseEntity<Map> disable = rest.exchange(url("/api/products/2/disable"),
                HttpMethod.POST, json(token, "{}"), Map.class);
        assertThat(disable.getStatusCode()).isEqualTo(HttpStatus.NOT_FOUND);
        Map error = (Map) disable.getBody().get("error");
        assertThat(String.valueOf(error.get("code"))).isEqualTo("PRODUCT_NOT_FOUND");
    }

    // update in scope -> OK (sales-manager, scope Sales+Sales-East, product 2)
    @Test
    void updateInScopeOk() {
        String token = token("sales-manager", "admin123");
        ResponseEntity<Map> update = rest.exchange(url("/api/products/2"),
                HttpMethod.PUT, json(token, "{\"code\":\"PRD-002\",\"name\":\"P-SALES-1-renamed\"}"), Map.class);
        assertThat(update.getStatusCode()).isEqualTo(HttpStatus.OK);
        assertThat(((Map) update.getBody().get("data")).get("name")).isEqualTo("P-SALES-1-renamed");
    }
}
