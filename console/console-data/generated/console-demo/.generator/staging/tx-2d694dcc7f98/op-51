package com.acme.core.application.rbac;

import com.acme.core.common.core.ErrorCode;
import com.acme.core.common.core.PlatformException;
import com.acme.core.domain.entity.SysPermission;

import java.util.List;
import java.util.Optional;

/**
 * Permission governance application service (generated by engineering-platform 0.1.0).
 *
 * READ-ONLY registry-style: permission codes come from system/asset declarations,
 * not from UI creation. Persistence goes through {@link PermissionManagementPort} —
 * no MyBatis types appear in this class.
 */
public class PermissionManagementService {

    private final PermissionManagementPort managementPort;

    public PermissionManagementService(PermissionManagementPort managementPort) {
        this.managementPort = managementPort;
    }

    public List<SysPermission> list(String code) {
        return managementPort.list(code);
    }

    public SysPermission detail(Long id) {
        Optional<SysPermission> permission = managementPort.findById(id);
        if (permission.isEmpty()) {
            throw new PlatformException(ErrorCode.of("PERMISSION_NOT_FOUND",
                    "permission not found: " + id));
        }
        return permission.get();
    }
}
