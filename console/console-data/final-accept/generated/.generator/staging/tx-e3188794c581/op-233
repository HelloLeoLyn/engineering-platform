package com.acme.core.application.warehouse;

import com.acme.core.application.datascope.DataPermissionContext;
import com.acme.core.application.dictionary.DictionaryPort;
import com.acme.core.common.core.ErrorCode;
import com.acme.core.common.core.PageQuery;
import com.acme.core.common.core.PageResult;
import com.acme.core.common.core.PlatformException;
import com.acme.core.domain.entity.DictionaryItem;
import com.acme.core.domain.entity.Warehouse;

import java.time.LocalDateTime;
import java.util.List;

/**
 * Warehouse application service (generated by engineering-platform Generic Module Generator).
 * Client never supplies createdBy/departmentId: they come from the authenticated RequestContext.
 */
public class WarehouseService {

    private final WarehousePort warehousePort;
    private final DictionaryPort dictionaryPort;

    public WarehouseService(WarehousePort warehousePort, DictionaryPort dictionaryPort) {
        this.warehousePort = warehousePort;
        this.dictionaryPort = dictionaryPort;
    }

    public WarehouseResponse create(WarehouseCreateRequest request, Long userId, Long departmentId) {
        if (request.code() == null || request.code().isBlank()) {
            throw new PlatformException(ErrorCode.of("WAREHOUSE_CODE_REQUIRED", "code is required"));
        }
        if (warehousePort.existsByUnique(String.valueOf(request.code()), null)) {
            throw new PlatformException(ErrorCode.of("WAREHOUSE_CODE_DUPLICATE", "code already exists"));
        }
        if (request.name() == null || request.name().isBlank()) {
            throw new PlatformException(ErrorCode.of("WAREHOUSE_NAME_REQUIRED", "name is required"));
        }
        if (request.status() == null || request.status().isBlank()) {
            throw new PlatformException(ErrorCode.of("WAREHOUSE_STATUS_REQUIRED", "status is required"));
        }
        Warehouse warehouse = new Warehouse();
        warehouse.setCode(request.code());
        warehouse.setName(request.name());
        warehouse.setAddress(request.address());
        warehouse.setManager(request.manager());
        warehouse.setStatus(request.status());
        warehouse.setDepartmentId(departmentId);
        warehouse.setCreatedBy(userId);
        LocalDateTime now = LocalDateTime.now();
        warehouse.setCreatedAt(now);
        warehouse.setUpdatedAt(now);
        warehousePort.insert(warehouse);
        return toResponse(warehouse);
    }

    public WarehouseResponse get(Long id, DataPermissionContext context) {
        Warehouse warehouse = warehousePort.findByIdInScope(id, context)
                .orElseThrow(() -> new PlatformException(ErrorCode.of("WAREHOUSE_NOT_FOUND", "warehouse not found: " + id)));
        return toResponse(warehouse);
    }

    public List<WarehouseResponse> list(DataPermissionContext context) {
        return warehousePort.findByScope(context).stream().map(this::toResponse).toList();
    }

    public PageResult<WarehouseResponse> page(PageQuery query, DataPermissionContext context) {
        PageResult<Warehouse> result = warehousePort.findPageByScope(context, query);
        List<WarehouseResponse> items = result.items().stream().map(this::toResponse).toList();
        return PageResult.of(items, result.total(), result.page(), result.size());
    }

    public PageResult<WarehouseResponse> pageFiltered(PageQuery query, DataPermissionContext context, String keyword, String status, String code, String name) {
        PageResult<Warehouse> result = warehousePort.findPageByScopeFiltered(context, query, keyword, status, code, name);
        List<WarehouseResponse> items = result.items().stream().map(this::toResponse).toList();
        return PageResult.of(items, result.total(), result.page(), result.size());
    }

    public WarehouseResponse update(Long id, WarehouseUpdateRequest request, DataPermissionContext context) {
        Warehouse warehouse = warehousePort.findByIdInScope(id, context)
                .orElseThrow(() -> new PlatformException(ErrorCode.of("WAREHOUSE_NOT_FOUND", "warehouse not found: " + id)));
        if (request.code() == null || request.code().isBlank()) {
            throw new PlatformException(ErrorCode.of("WAREHOUSE_CODE_REQUIRED", "code is required"));
        }
        if (warehousePort.existsByUnique(String.valueOf(request.code()), id)) {
            throw new PlatformException(ErrorCode.of("WAREHOUSE_CODE_DUPLICATE", "code already exists"));
        }
        if (request.name() == null || request.name().isBlank()) {
            throw new PlatformException(ErrorCode.of("WAREHOUSE_NAME_REQUIRED", "name is required"));
        }
        if (request.status() == null || request.status().isBlank()) {
            throw new PlatformException(ErrorCode.of("WAREHOUSE_STATUS_REQUIRED", "status is required"));
        }
        warehouse.setCode(request.code());
        warehouse.setName(request.name());
        warehouse.setAddress(request.address());
        warehouse.setManager(request.manager());
        warehouse.setStatus(request.status());
        warehouse.setUpdatedAt(LocalDateTime.now());
        warehousePort.update(warehouse);
        return toResponse(warehouse);
    }

    public WarehouseResponse disable(Long id, DataPermissionContext context) {
        Warehouse warehouse = warehousePort.findByIdInScope(id, context)
                .orElseThrow(() -> new PlatformException(ErrorCode.of("WAREHOUSE_NOT_FOUND", "warehouse not found: " + id)));
        warehouse.setStatus("DISABLED");
        warehouse.setUpdatedAt(LocalDateTime.now());
        warehousePort.update(warehouse);
        return toResponse(warehouse);
    }

    private void validateDictionary(String code, String value) {
        if (value == null || value.isBlank()) return;
        dictionaryPort.findTypeByCode(code).ifPresent(type -> {
            java.util.Set<String> values = dictionaryPort.findItemsByTypeId(type.getId()).stream()
                    .map(DictionaryItem::getValue).collect(java.util.stream.Collectors.toSet());
            if (!values.isEmpty() && !values.contains(value)) {
                throw new PlatformException(ErrorCode.of("WAREHOUSE_DICTIONARY_INVALID", "value not in dictionary " + code + ": " + value));
            }
        });
    }

    private WarehouseResponse toResponse(Warehouse e) {
        return WarehouseResponse.of(e.getId(), e.getCode(), e.getName(), e.getAddress(), e.getManager(), e.getStatus(), e.getDepartmentId(), e.getCreatedBy(), e.getCreatedAt(), e.getUpdatedAt());
    }
}
