package com.acme.core.infrastructure.persistence;

import com.acme.core.application.customer.CustomerPort;
import com.acme.core.application.datascope.DataPermissionContext;
import com.acme.core.application.organization.DepartmentPort;
import com.acme.core.common.core.PageQuery;
import com.acme.core.common.core.PageResult;
import com.acme.core.common.security.DataScope;
import com.acme.core.domain.entity.Customer;
import com.acme.core.infrastructure.persistence.mapper.CustomerMapper;
import com.baomidou.mybatisplus.core.conditions.query.QueryWrapper;

import java.util.List;
import java.util.Optional;
import java.util.Set;

/**
 * MyBatis-Plus implementation of {@link CustomerPort} (generated by engineering-platform Generic Module Generator).
 * Data scope enforcement happens HERE at the query boundary: ALL / DEPARTMENT /
 * DEPARTMENT_AND_CHILDREN / SELF. Fail-safe: missing department with a department-
 * dependent scope denies (empty), never upgrades to ALL.
 */
public class MybatisCustomerRepository implements CustomerPort {

    private final CustomerMapper customerMapper;
    private final DepartmentPort departmentPort;

    public MybatisCustomerRepository(CustomerMapper customerMapper, DepartmentPort departmentPort) {
        this.customerMapper = customerMapper;
        this.departmentPort = departmentPort;
    }

    @Override
    public Optional<Customer> findById(Long id) {
        return Optional.ofNullable(customerMapper.selectById(id));
    }

    @Override
    public Optional<Customer> findByIdInScope(Long id, DataPermissionContext context) {
        return findByScope(context).stream().filter(e -> e.getId().equals(id)).findFirst();
    }

    @Override
    public List<Customer> findByScope(DataPermissionContext context) {
        QueryWrapper<Customer> wrapper = scopeWrapper(context);
        wrapper.orderByAsc("id");
        return customerMapper.selectList(wrapper);
    }

    @Override
    public PageResult<Customer> findPageByScope(DataPermissionContext context, PageQuery query) {
        QueryWrapper<Customer> countWrapper = scopeWrapper(context);
        long total = customerMapper.selectCount(countWrapper);
        QueryWrapper<Customer> pageWrapper = scopeWrapper(context);
        pageWrapper.orderByAsc("id");
        pageWrapper.last("LIMIT " + query.size() + " OFFSET " + query.offset());
        List<Customer> items = customerMapper.selectList(pageWrapper);
        return PageResult.of(items, total, query.page(), query.size());
    }

    @Override
    public PageResult<Customer> findPageByScopeFiltered(DataPermissionContext context, PageQuery query, String keyword, String status, String code, String name) {
        QueryWrapper<Customer> countWrapper = scopeWrapper(context);
        applyFilters(countWrapper, keyword, status, code, name);
        long total = customerMapper.selectCount(countWrapper);
        QueryWrapper<Customer> pageWrapper = scopeWrapper(context);
        applyFilters(pageWrapper, keyword, status, code, name);
        pageWrapper.orderByAsc("id");
        pageWrapper.last("LIMIT " + query.size() + " OFFSET " + query.offset());
        List<Customer> items = customerMapper.selectList(pageWrapper);
        return PageResult.of(items, total, query.page(), query.size());
    }

    private void applyFilters(QueryWrapper<Customer> wrapper, String keyword, String status, String code, String name) {
        if (code != null && !code.isBlank()) {
            wrapper.like("code", code);
        }
        if (name != null && !name.isBlank()) {
            wrapper.like("name", name);
        }
        if (keyword != null && !keyword.isBlank()) {
            wrapper.and(w -> {w.like("code", keyword) .or().like("name", keyword) .or().like("phone", keyword) .or().like("status", keyword) .or().like("level", keyword); });
        }
        if (status != null && !status.isBlank()) {
            wrapper.eq("status", status);
        }
    }

    private QueryWrapper<Customer> scopeWrapper(DataPermissionContext context) {
        QueryWrapper<Customer> wrapper = new QueryWrapper<>();
        DataScope scope = context.scope() == null ? DataScope.SELF : context.scope();
        switch (scope) {
            case ALL -> { }
            case DEPARTMENT -> {
                if (context.departmentId() == null) { wrapper.eq("id", -1L); } else { wrapper.eq("department_id", context.departmentId()); }
            }
            case DEPARTMENT_AND_CHILDREN -> {
                if (context.departmentId() == null) { wrapper.eq("id", -1L); } else {
                    Set<Long> ids = departmentPort.descendantIds(context.departmentId());
                    ids.add(context.departmentId());
                    wrapper.in("department_id", ids);
                }
            }
            case SELF -> {
                if (context.userId() == null) { wrapper.eq("id", -1L); } else { wrapper.eq("created_by", String.valueOf(context.userId())); }
            }
        }
        return wrapper;
    }

    @Override
    public boolean existsByUnique(String value, Long excludeId) {
        QueryWrapper<Customer> wrapper = new QueryWrapper<>();
        wrapper.eq("code", value);
        if (excludeId != null) { wrapper.ne("id", excludeId); }
        return customerMapper.selectCount(wrapper) > 0;
    }

    @Override
    public Customer insert(Customer entity) {
        customerMapper.insert(entity);
        return entity;
    }

    @Override
    public int update(Customer entity) {
        return customerMapper.updateById(entity);
    }
}
