// Dev server proxies /api to the backend so the frontend never hardcodes a
// backend host/port. Override with VITE_BACKEND_URL (e.g. http://localhost:8080).
const backendUrl: string = process.env.VITE_BACKEND_URL ?? 'http://localhost:8080';

export default defineConfig({
  plugins: [vue()],
  server: {
    port: 5173,
    proxy: {
      '/api': {
        target: backendUrl,
        changeOrigin: true,
      },
    },
  },
  test: {
    environment: 'jsdom',
    globals: true,
  },
});
