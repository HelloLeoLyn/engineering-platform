package com.acme.core;

import com.acme.core.application.dictionary.DictionaryPort;
import com.acme.core.application.dictionary.DictionaryService;
import com.acme.core.domain.entity.DictionaryItem;
import com.acme.core.domain.entity.DictionaryType;

import java.util.List;
import java.util.Optional;

import org.junit.jupiter.api.Test;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;

/**
 * Dictionary model unit tests (generated by engineering-platform 0.1.0).
 *
 * Covers: enabled query, disabled item filtering, disabled type reject,
 * missing type reject, stable ordering (sort then id), DTO boundary.
 */
class DictionaryModelUnitTest {

    private static DictionaryType type(Long id, String code, boolean enabled) {
        DictionaryType t = new DictionaryType();
        t.setId(id);
        t.setCode(code);
        t.setEnabled(enabled);
        return t;
    }

    private static DictionaryItem item(Long id, Long typeId, String value, boolean enabled, int sort) {
        DictionaryItem i = new DictionaryItem();
        i.setId(id);
        i.setTypeId(typeId);
        i.setValue(value);
        i.setLabel(value);
        i.setEnabled(enabled);
        i.setSort(sort);
        return i;
    }

    private static final DictionaryPort PORT = new DictionaryPort() {
        @Override
        public Optional<DictionaryType> findTypeByCode(String code) {
            if ("missing".equals(code)) {
                return Optional.empty();
            }
            if ("disabled-type".equals(code)) {
                return Optional.of(type(3L, code, false));
            }
            return Optional.of(type(1L, code, true));
        }

        @Override
        public List<DictionaryItem> findItemsByTypeId(Long typeId) {
            return List.of(
                    item(1L, typeId, "C", true, 3),
                    item(2L, typeId, "A", true, 1),
                    item(3L, typeId, "B", true, 1),
                    item(4L, typeId, "X", false, 5));
        }
    };

    private final DictionaryService service = new DictionaryService(PORT);

    // enabled query returns only enabled items
    @Test
    void enabledItemsOnly() {
        List<?> items = service.itemsOf("gender");
        assertThat(items).hasSize(3); // disabled item (X) filtered out
    }

    // stable ordering: sort asc, then id asc (A and B share sort=1 -> id order)
    @Test
    void stableOrdering() {
        var items = service.itemsOf("gender");
        assertThat(items.get(0).value()).isEqualTo("A");
        assertThat(items.get(1).value()).isEqualTo("B");
        assertThat(items.get(2).value()).isEqualTo("C");
    }

    // missing type -> DICTIONARY_TYPE_NOT_FOUND
    @Test
    void missingTypeRejected() {
        assertThatThrownBy(() -> service.itemsOf("missing"))
                .isInstanceOfSatisfying(
                        com.acme.core.common.core.PlatformException.class,
                        e -> assertThat(e.errorCode().code()).isEqualTo("DICTIONARY_TYPE_NOT_FOUND"));
    }

    // disabled type -> DICTIONARY_TYPE_DISABLED
    @Test
    void disabledTypeRejected() {
        assertThatThrownBy(() -> service.itemsOf("disabled-type"))
                .isInstanceOfSatisfying(
                        com.acme.core.common.core.PlatformException.class,
                        e -> assertThat(e.errorCode().code()).isEqualTo("DICTIONARY_TYPE_DISABLED"));
    }

    // DTO boundary: API never exposes the entity
    @Test
    void dtoBoundary() {
        var items = service.itemsOf("gender");
        assertThat(items.get(0)).isInstanceOf(com.acme.core.application.dictionary.DictionaryItemDto.class);
    }
}
