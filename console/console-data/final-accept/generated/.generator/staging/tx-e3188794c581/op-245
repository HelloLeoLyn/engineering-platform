<script setup lang="ts">
// Warehouse List (generated by engineering-platform Generic Module Generator)
// EP UI 2.0 generic list: header + optional stats + search panel + data card.
import { computed, onMounted, reactive, ref } from 'vue';
import { useRouter } from 'vue-router';
import PageHeader from '../../components/PageHeader.vue';
import PageContainer from '../../components/PageContainer.vue';
import SearchForm from '../../components/SearchForm.vue';
import AppTable from '../../components/AppTable.vue';
import StatCard from '../../components/StatCard.vue';
import ConfirmAction from '../../components/ConfirmAction.vue';
import FormDrawer from '../../components/FormDrawer.vue';
import AppForm from '../../components/AppForm.vue';
import PermissionButton from '../../permission/PermissionButton.vue';
import { warehouseApi } from '../../api/warehouse';
import type { Warehouse } from '../../types/warehouse';
import { errorMessage, notifySuccess, toastSuccess } from '../../utils/feedback';

const router = useRouter();
const loading = ref(false);
const listError = ref<string | null>(null);
const rows = ref<Warehouse[]>([]);
const total = ref(0);
const page = ref(1);
const size = ref(20);
const filters = reactive({ keyword: '', code: '', name: '' });

const drawerOpen = ref(false);
const editing = ref<Warehouse | null>(null);
const submitting = ref(false);
const formError = ref<string | null>(null);
const form = reactive({code: '', name: '', address: '', manager: '', status: '' });

const enabledCount = computed(() => rows.value.filter(r => r.status === 'ENABLED').length);
const disabledCount = computed(() => rows.value.length - enabledCount.value);

async function load(): Promise<void> {
  loading.value = true;
  listError.value = null;
  try {
    const result = await warehouseApi.page({
      page: page.value,
      size: size.value,
      keyword: filters.keyword || undefined,
      code: filters.code || undefined,
      name: filters.name || undefined,
    });
    rows.value = result.items;
    total.value = result.total;
  } catch (e) { listError.value = errorMessage(e); } finally { loading.value = false; }
}

function resetFilters(): void {
  filters.keyword = '';
  filters.code = '';
  filters.name = '';
  page.value = 1;
  load();
}

function openCreate(): void {
  editing.value = null;
  formError.value = null;
  Object.assign(form, {code: '', name: '', address: '', manager: '', status: '' });
  drawerOpen.value = true;
}

function openEdit(p: Warehouse): void {
  editing.value = p;
  formError.value = null;
  Object.assign(form, {code: p.code, name: p.name, address: p.address, manager: p.manager, status: p.status });
  drawerOpen.value = true;
}

async function submit(): Promise<void> {
  submitting.value = true;
  formError.value = null;
  const body = {code: form.code, name: form.name, address: form.address, manager: form.manager, status: form.status };
  try {
    if (editing.value) { await warehouseApi.update(editing.value.id, body); notifySuccess('Warehouse updated'); }
    else { await warehouseApi.create(body); notifySuccess('Warehouse created'); }
    drawerOpen.value = false;
    await load();
  } catch (e) { formError.value = errorMessage(e); } finally { submitting.value = false; }
}

async function doDisable(p: Warehouse): Promise<void> {
  try { await warehouseApi.disable(p.id); toastSuccess('Warehouse disabled'); await load(); }
  catch (e) { toastSuccess(errorMessage(e)); }
}

onMounted(load);
</script>

<template>
  <PageContainer full-width>
    <PageHeader title="Warehouses" description="Generic business module — warehouse." eyebrow="Warehouse">
      <template #actions>
        <PermissionButton permission="warehouse:item:create" type="primary" data-testid="create-warehouse" @click="openCreate">Create Warehouse</PermissionButton>
      </template>
    </PageHeader>

    <div v-if="total > 0" class="list-stats" data-testid="list-stats">
      <StatCard label="Total" :value="total" accent="indigo" marker="T" />
      <StatCard label="Enabled" :value="enabledCount" accent="emerald" marker="E" />
      <StatCard label="Disabled" :value="disabledCount" accent="rose" marker="D" />
    </div>

    <SearchForm more @search="load" @reset="resetFilters">
      <el-input v-model="filters.keyword" placeholder="Search" clearable style="width: 240px" data-testid="warehouse-search-keyword" />
      <el-input v-model="filters.code" placeholder="Code" clearable style="width: 200px" data-testid="warehouse-search-code" />
      <el-input v-model="filters.name" placeholder="Name" clearable style="width: 200px" data-testid="warehouse-search-name" />
    </SearchForm>

    <AppTable :loading="loading" :error="listError" :data="rows" :total="total" :page="page" :size="size" @refresh="load" @update:page="(p: number) => { page = p; load(); }" @update:size="(s: number) => { size = s; page = 1; load(); }">
      <el-table-column prop="code" label="Code" min-width="130" />
      <el-table-column prop="name" label="Name" min-width="130" />
      <el-table-column prop="address" label="Address" min-width="130" />
      <el-table-column prop="manager" label="Manager" min-width="130" />
      <el-table-column prop="status" label="Status" min-width="130" />
      <el-table-column prop="departmentId" label="Department" width="120"><template #default="{ row }">{{ row.departmentId ?? '—' }}</template></el-table-column>
      <el-table-column label="Actions" width="180" fixed="right">
        <template #default="{ row }">
          <el-button size="small" type="primary" link data-testid="warehouse-detail-open" @click="router.push({ path: '/warehouse/' + row.id })">Detail</el-button>
          <el-button size="small" link data-testid="warehouse-open" @click="openEdit(row)">Edit</el-button>
          <ConfirmAction v-if="row.status === 'ENABLED'" :title="'Disable ' + row.id + '?'" @confirm="doDisable(row)">
            <PermissionButton permission="warehouse:item:disable" size="small" type="danger" link data-testid="warehouse-disable-trigger">Disable</PermissionButton>
          </ConfirmAction>
        </template>
      </el-table-column>
    </AppTable>

    <FormDrawer v-model="drawerOpen" :title="editing ? 'Edit Warehouse' : 'Create Warehouse'">
      <AppForm :model="form as unknown as Record<string, unknown>" :submitting="submitting" :error="formError" :submit-text="editing ? 'Save' : 'Create'" compact @submit="submit" @cancel="drawerOpen = false">
        <el-form-item label="Code" :rules="[{ required: true, message: 'Code is required' }]">
          <el-input v-model="form.code" data-testid="warehouse-form-code" />
        </el-form-item>
        <el-form-item label="Name" :rules="[{ required: true, message: 'Name is required' }]">
          <el-input v-model="form.name" data-testid="warehouse-form-name" />
        </el-form-item>
        <el-form-item label="Address">
          <el-input v-model="form.address" data-testid="warehouse-form-address" />
        </el-form-item>
        <el-form-item label="Manager">
          <el-input v-model="form.manager" data-testid="warehouse-form-manager" />
        </el-form-item>
        <el-form-item label="Status" :rules="[{ required: true, message: 'Status is required' }]">
          <el-input v-model="form.status" data-testid="warehouse-form-status" />
        </el-form-item>
        <div class="form-hint">Department and creator are set by the server from your session — never from the client.</div>
      </AppForm>
    </FormDrawer>
  </PageContainer>
</template>

