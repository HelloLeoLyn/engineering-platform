package com.acme.core.infrastructure.persistence;

import com.acme.core.application.warehouse.WarehousePort;
import com.acme.core.application.warehouse.WarehouseService;
import com.acme.core.application.organization.DepartmentPort;
import com.acme.core.application.dictionary.DictionaryPort;
import com.acme.core.infrastructure.persistence.mapper.WarehouseMapper;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

/**
 * Warehouse bean wiring (generated by engineering-platform Generic Module Generator).
 */
@Configuration
public class WarehouseBeansConfig {

    @Bean
    public WarehousePort warehousePort(WarehouseMapper mapper, DepartmentPort departmentPort) {
        return new MybatisWarehouseRepository(mapper, departmentPort);
    }

    @Bean
    public WarehouseService warehouseService(WarehousePort port, DictionaryPort dictionaryPort) {
        return new WarehouseService(port, dictionaryPort);
    }
}
