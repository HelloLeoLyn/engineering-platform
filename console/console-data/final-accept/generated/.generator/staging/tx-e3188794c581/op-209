package com.acme.core.application.customer;

import com.acme.core.application.datascope.DataPermissionContext;
import com.acme.core.application.dictionary.DictionaryPort;
import com.acme.core.common.core.ErrorCode;
import com.acme.core.common.core.PageQuery;
import com.acme.core.common.core.PageResult;
import com.acme.core.common.core.PlatformException;
import com.acme.core.domain.entity.DictionaryItem;
import com.acme.core.domain.entity.Customer;

import java.time.LocalDateTime;
import java.util.List;

/**
 * Customer application service (generated by engineering-platform Generic Module Generator).
 * Client never supplies createdBy/departmentId: they come from the authenticated RequestContext.
 */
public class CustomerService {

    private final CustomerPort customerPort;
    private final DictionaryPort dictionaryPort;

    public CustomerService(CustomerPort customerPort, DictionaryPort dictionaryPort) {
        this.customerPort = customerPort;
        this.dictionaryPort = dictionaryPort;
    }

    public CustomerResponse create(CustomerCreateRequest request, Long userId, Long departmentId) {
        if (request.code() == null || request.code().isBlank()) {
            throw new PlatformException(ErrorCode.of("CUSTOMER_CODE_REQUIRED", "code is required"));
        }
        if (customerPort.existsByUnique(String.valueOf(request.code()), null)) {
            throw new PlatformException(ErrorCode.of("CUSTOMER_CODE_DUPLICATE", "code already exists"));
        }
        if (request.name() == null || request.name().isBlank()) {
            throw new PlatformException(ErrorCode.of("CUSTOMER_NAME_REQUIRED", "name is required"));
        }
        validateDictionary("customer_status", request.status());
        validateDictionary("customer_level", request.level());
        Customer customer = new Customer();
        customer.setCode(request.code());
        customer.setName(request.name());
        customer.setPhone(request.phone());
        customer.setStatus(request.status());
        customer.setLevel(request.level());
        customer.setDepartmentId(departmentId);
        customer.setCreatedBy(userId);
        LocalDateTime now = LocalDateTime.now();
        customer.setCreatedAt(now);
        customer.setUpdatedAt(now);
        customerPort.insert(customer);
        return toResponse(customer);
    }

    public CustomerResponse get(Long id, DataPermissionContext context) {
        Customer customer = customerPort.findByIdInScope(id, context)
                .orElseThrow(() -> new PlatformException(ErrorCode.of("CUSTOMER_NOT_FOUND", "customer not found: " + id)));
        return toResponse(customer);
    }

    public List<CustomerResponse> list(DataPermissionContext context) {
        return customerPort.findByScope(context).stream().map(this::toResponse).toList();
    }

    public PageResult<CustomerResponse> page(PageQuery query, DataPermissionContext context) {
        PageResult<Customer> result = customerPort.findPageByScope(context, query);
        List<CustomerResponse> items = result.items().stream().map(this::toResponse).toList();
        return PageResult.of(items, result.total(), result.page(), result.size());
    }

    public PageResult<CustomerResponse> pageFiltered(PageQuery query, DataPermissionContext context, String keyword, String status, String code, String name) {
        PageResult<Customer> result = customerPort.findPageByScopeFiltered(context, query, keyword, status, code, name);
        List<CustomerResponse> items = result.items().stream().map(this::toResponse).toList();
        return PageResult.of(items, result.total(), result.page(), result.size());
    }

    public CustomerResponse update(Long id, CustomerUpdateRequest request, DataPermissionContext context) {
        Customer customer = customerPort.findByIdInScope(id, context)
                .orElseThrow(() -> new PlatformException(ErrorCode.of("CUSTOMER_NOT_FOUND", "customer not found: " + id)));
        if (request.code() == null || request.code().isBlank()) {
            throw new PlatformException(ErrorCode.of("CUSTOMER_CODE_REQUIRED", "code is required"));
        }
        if (customerPort.existsByUnique(String.valueOf(request.code()), id)) {
            throw new PlatformException(ErrorCode.of("CUSTOMER_CODE_DUPLICATE", "code already exists"));
        }
        if (request.name() == null || request.name().isBlank()) {
            throw new PlatformException(ErrorCode.of("CUSTOMER_NAME_REQUIRED", "name is required"));
        }
        validateDictionary("customer_status", request.status());
        validateDictionary("customer_level", request.level());
        customer.setCode(request.code());
        customer.setName(request.name());
        customer.setPhone(request.phone());
        customer.setStatus(request.status());
        customer.setLevel(request.level());
        customer.setUpdatedAt(LocalDateTime.now());
        customerPort.update(customer);
        return toResponse(customer);
    }

    public CustomerResponse disable(Long id, DataPermissionContext context) {
        Customer customer = customerPort.findByIdInScope(id, context)
                .orElseThrow(() -> new PlatformException(ErrorCode.of("CUSTOMER_NOT_FOUND", "customer not found: " + id)));
        customer.setStatus("DISABLED");
        customer.setUpdatedAt(LocalDateTime.now());
        customerPort.update(customer);
        return toResponse(customer);
    }

    private void validateDictionary(String code, String value) {
        if (value == null || value.isBlank()) return;
        dictionaryPort.findTypeByCode(code).ifPresent(type -> {
            java.util.Set<String> values = dictionaryPort.findItemsByTypeId(type.getId()).stream()
                    .map(DictionaryItem::getValue).collect(java.util.stream.Collectors.toSet());
            if (!values.isEmpty() && !values.contains(value)) {
                throw new PlatformException(ErrorCode.of("CUSTOMER_DICTIONARY_INVALID", "value not in dictionary " + code + ": " + value));
            }
        });
    }

    private CustomerResponse toResponse(Customer e) {
        return CustomerResponse.of(e.getId(), e.getCode(), e.getName(), e.getPhone(), e.getStatus(), e.getLevel(), e.getDepartmentId(), e.getCreatedBy(), e.getCreatedAt(), e.getUpdatedAt());
    }
}
