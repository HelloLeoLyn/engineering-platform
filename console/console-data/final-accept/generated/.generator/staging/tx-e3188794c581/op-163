<script setup lang="ts">
// PermissionGuard (generated by engineering-platform frontend-permission asset)
// Renders slot only when the current user has the required permission.
import { computed } from 'vue';
import { hasAnyPermission } from './index';

const props = withDefaults(
  defineProps<{
    permission: string | string[];
    fallback?: boolean;
  }>(),
  { fallback: false },
);

const allowed = computed(() =>
  hasAnyPermission(Array.isArray(props.permission) ? props.permission : [props.permission]),
);
</script>

<template>
  <slot v-if="allowed" />
  <slot v-else-if="fallback" name="fallback" />
</template>
