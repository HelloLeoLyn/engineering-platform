package ${package}.common.security;

/**
 * Menu type V1 (generated by engineering-platform ${asset.version}).
 *
 * Backend permission resource model, NOT a frontend route table:
 *   DIRECTORY → navigation container (no permission code of its own)
 *   MENU      → a navigable resource, may reference a permission code
 *   ACTION    → a backend action button/operation, references a permission code
 *
 * A menu's permissionCode references an existing RBAC permission (sys_permission.code)
 * for visibility filtering only — it never replaces @RequirePermission authorization.
 */
public enum MenuType {

    DIRECTORY("DIRECTORY"),
    MENU("MENU"),
    ACTION("ACTION");

    private final String code;

    MenuType(String code) {
        this.code = code;
    }

    public String code() {
        return code;
    }

    public static MenuType fromCode(String code) {
        if (code == null) {
            return null;
        }
        for (MenuType type : values()) {
            if (type.code.equals(code)) {
                return type;
            }
        }
        return null;
    }
}
