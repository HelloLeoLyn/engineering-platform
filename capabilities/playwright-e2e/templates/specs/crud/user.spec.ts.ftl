// User Management Browser E2E (generated by engineering-platform playwright-e2e asset)
import { test, expect, loginAs } from './fixtures';

test.describe('user management', () => {
  test.beforeEach(async ({ page }) => {
    await loginAs(page, 'admin', 'admin123');
    await page.getByText('System').first().click();
    await page.getByRole('menuitem', { name: /User management/i }).first().click();
    await page.waitForURL(/\/system\/users/, { timeout: 15_000 });
  });

  test('list + search/filter works', async ({ page }) => {
    await expect(page.getByText('User Management').first()).toBeVisible({ timeout: 15_000 });
    await page.getByTestId('user-search-username').fill('admin');
    await page.getByTestId('search-form-submit').click();
    await expect(page.getByText('admin').first()).toBeVisible({ timeout: 10_000 });
  });

  test('create user with department + roles, initial password shown once', async ({ page }) => {
    const username = 'e2e-user-' + Date.now().toString().slice(-6);
    await page.getByTestId('create-user').click();
    await page.getByTestId('user-form-username').fill(username);
    await page.getByTestId('user-form-password').fill('E2ePass123!');
    // department selector — pick first option (force: Element Plus dropdown animation)
    await page.getByTestId('user-form-department').click();
    await page.getByRole('option').first().click({ force: true, timeout: 8_000 });
    // roles selector — pick first option
    await page.getByTestId('user-form-roles').click();
    await page.getByRole('option').first().click({ force: true, timeout: 8_000 });
    await page.getByTestId('app-form-submit').click();
    await expect(page.getByTestId('initial-password-alert')).toBeVisible({ timeout: 10_000 });
    await expect(page.getByTestId('initial-password-alert')).toContainText('Initial password');
    await expect(page.getByText(username).first()).toBeVisible({ timeout: 10_000 });
  });

  test('edit user basic info', async ({ page }) => {
    await page.getByTestId('user-search-username').fill('admin');
    await page.getByTestId('search-form-submit').click();
    await expect(page.getByText('admin').first()).toBeVisible({ timeout: 10_000 });
    // open edit via row more menu -> Edit
    await page.getByTestId('user-row-more').first().click();
    await page.getByRole('menuitem', { name: /Edit/i }).first().click();
    await expect(page.getByTestId('user-form-username')).toBeVisible({ timeout: 10_000 });
    await page.getByTestId('app-form-submit').click();
    // drawer closes; page still functional (list visible again)
    await expect(page.getByTestId('create-user')).toBeVisible({ timeout: 10_000 });
  });

  test('disable requires confirm and shows feedback', async ({ page }) => {
    const username = 'e2e-disable-' + Date.now().toString().slice(-6);
    await page.getByTestId('create-user').click();
    await page.getByTestId('user-form-username').fill(username);
    await page.getByTestId('user-form-password').fill('E2ePass123!');
    await page.getByTestId('app-form-submit').click();
    await expect(page.getByTestId('initial-password-alert')).toBeVisible({ timeout: 10_000 });
    await page.getByTestId('user-search-username').fill(username);
    await page.getByTestId('search-form-submit').click();
    await expect(page.getByText(username).first()).toBeVisible({ timeout: 10_000 });
    await page.getByTestId('user-row-more').first().click();
    await page.getByTestId('disable-user').click();
    // ElMessageBox confirm (last Disable button in the dialog)
    await page.locator('.el-message-box').getByRole('button', { name: /Disable/i }).click();
    await expect(page.getByText('User disabled').first()).toBeVisible({ timeout: 10_000 });
  });
});
