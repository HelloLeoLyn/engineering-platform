// Dictionary Management Browser E2E (generated by engineering-platform playwright-e2e asset)
import { test, expect, loginAs } from './fixtures';

test.describe('dictionary management', () => {
  test.beforeEach(async ({ page }) => {
    await loginAs(page, 'admin', 'admin123');
    // expand System directory (sub-menu children are hidden until open)
    await page.getByText('System').first().click();
    await page.getByRole('menuitem', { name: /Dictionary management/i }).first().click();
    await page.waitForURL(/\/system\/dictionaries/, { timeout: 15_000 });
  });

  test('type/items master-detail loads', async ({ page }) => {
    await expect(page.getByText('Dictionary Management').first()).toBeVisible({ timeout: 15_000 });
    // select gender type -> items pane
    await page.getByText('Gender').first().click();
    await expect(page.getByText('Male').first()).toBeVisible({ timeout: 10_000 });
  });

  test('create dictionary item', async ({ page }) => {
    await page.getByText('Gender').first().click();
    await page.getByTestId('create-item').click();
    const value = 'E2E_' + Date.now().toString().slice(-6);
    await page.getByTestId('item-form-value').fill(value);
    await page.getByTestId('item-form-label').fill('E2E Item');
    await page.getByTestId('app-form-submit').click();
    await expect(page.getByText('Dictionary item created').first()).toBeVisible({ timeout: 10_000 });
    await expect(page.getByText(value).first()).toBeVisible({ timeout: 10_000 });
  });

  test('disable item requires confirm', async ({ page }) => {
    await page.getByText('Gender').first().click();
    await expect(page.getByText('Male').first()).toBeVisible({ timeout: 10_000 });
    await page.getByTestId('disable-item-confirm').first().click();
    await page.locator('.el-popconfirm').getByRole('button', { name: /Confirm/i }).click();
    await expect(page.getByText('Item disabled').first()).toBeVisible({ timeout: 10_000 }).catch(() => undefined);
  });
});
