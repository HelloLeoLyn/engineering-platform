// Security Bypass + DataScope Browser E2E (generated by engineering-platform playwright-e2e asset)
import { test, expect, loginAs, apiToken } from './fixtures';
import { backendUrl } from '../playwright.config';

test.describe('security boundary', () => {
  test('read-only user sees no write buttons in UI', async ({ page }) => {
    await loginAs(page, 'viewer', 'admin123');
    // viewer has no product permissions — product menu pruned; force direct nav shows 403/permission state
    await page.goto('/products');
    // either permission-denied state or empty list; create button must NOT exist
    await expect(page.getByTestId('create-product')).not.toBeVisible({ timeout: 10_000 });
  });

  test('backend rejects write API for read-only user even when UI hides buttons (403)', async ({ page }) => {
    // bypass the frontend entirely: direct HTTP write with viewer token
    const token = await apiToken('viewer', 'admin123', backendUrl);
    const response = await fetch(backendUrl + '/api/products', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
      body: JSON.stringify({ code: 'HACK-001', name: 'bypass', status: 'ENABLED', category: null }),
    });
    expect(response.status).toBe(403);
    const body = (await response.json()) as { error?: { code?: string } };
    expect(body.error?.code ?? '').toMatch(/PERMISSION|DENIED|FORBIDDEN/i);
  });

  test('viewer cannot read products either (no product:item:read)', async ({ page }) => {
    const token = await apiToken('viewer', 'admin123', backendUrl);
    const response = await fetch(backendUrl + '/api/products', {
      headers: { Authorization: 'Bearer ' + token },
    });
    expect(response.status).toBe(403);
  });
});

test.describe('data scope', () => {
  test('admin (ALL) sees products across departments', async ({ page }) => {
    await loginAs(page, 'admin', 'admin123');
    await page.getByText('Products').first().click();
    await page.getByRole('menuitem', { name: /Product list/i }).first().click();
    await page.waitForURL(/\/products/, { timeout: 15_000 });
    // HQ product + finance product both visible (ALL scope)
    await expect(page.getByText('PRD-001').first()).toBeVisible({ timeout: 15_000 });
    await expect(page.getByText('PRD-005').first()).toBeVisible({ timeout: 10_000 });
  });

  test('sales-user (DEPARTMENT dept2) sees only own department products', async ({ page }) => {
    await loginAs(page, 'sales-user', 'admin123');
    await page.getByText('Products').first().click();
    await page.getByRole('menuitem', { name: /Product list/i }).first().click();
    await page.waitForURL(/\/products/, { timeout: 15_000 });
    // dept2 products visible (PRD-002, PRD-003)
    await expect(page.getByText('PRD-002').first()).toBeVisible({ timeout: 15_000 });
    // HQ product NOT visible (frontend does not filter — backend result excludes it)
    await expect(page.getByText('PRD-001').first()).not.toBeVisible({ timeout: 10_000 });
    // finance product NOT visible
    await expect(page.getByText('PRD-005').first()).not.toBeVisible({ timeout: 10_000 });
  });

  test('self-user (SELF) sees only own products and direct detail is denied', async ({ page }) => {
    await loginAs(page, 'self-user', 'admin123');
    await page.getByText('Products').first().click();
    await page.getByRole('menuitem', { name: /Product list/i }).first().click();
    await page.waitForURL(/\/products/, { timeout: 15_000 });
    await expect(page.getByText('PRD-006').first()).toBeVisible({ timeout: 15_000 }); // self-created
    // direct detail of another user's product -> denied (PRODUCT_NOT_FOUND / 404)
    const token = await apiToken('self-user', 'admin123', backendUrl);
    const response = await fetch(backendUrl + '/api/products/5', {
      headers: { Authorization: 'Bearer ' + token },
    });
    expect(response.status).toBe(404);
  });
});
