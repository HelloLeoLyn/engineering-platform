// Playwright test fixtures (generated by engineering-platform playwright-e2e asset)
import { test as base, expect } from '@playwright/test';
import type { Page } from '@playwright/test';

export const test = base;
export { expect };

/** Log in via the UI (login page flow). Returns the app URL after redirect. */
export async function loginAs(page: Page, username: string, password: string): Promise<string> {
  await page.goto('/login');
  await page.getByTestId('login-username').fill(username);
  await page.getByTestId('login-password').fill(password);
  await page.getByTestId('login-submit').click();
  await page.waitForURL(/\/(?!login)/, { timeout: 20_000 });
  return page.url();
}

/** API token via direct login call (for backend assertions like 403). */
export async function apiToken(username: string, password: string, backendUrl: string): Promise<string> {
  const response = await fetch(backendUrl + '/api/auth/login', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ username, password }),
  });
  expect(response.status).toBe(200);
  const body = (await response.json()) as { data: { token: string } };
  return body.data.token;
}
