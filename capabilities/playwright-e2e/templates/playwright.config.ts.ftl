// Playwright config (generated by engineering-platform playwright-e2e asset)
// Browser E2E for the generated app. URLs come from the Runtime Recipe state
// (.runtime/backend.url, .runtime/frontend.url) — never hardcoded.
import { defineConfig } from '@playwright/test';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const runtimeDir = path.resolve(__dirname, '../.runtime');

function readState(name: string): string {
  try {
    return fs.readFileSync(path.join(runtimeDir, name), 'utf-8').trim();
  } catch {
    return '';
  }
}

const frontendUrl = readState('frontend.url') || 'http://localhost:5173';
const backendUrl = readState('backend.url') || 'http://localhost:8080';

export default defineConfig({
  testDir: './specs',
  testMatch: '*.spec.ts', // Browser Gate = top-level smoke specs; crud/ excluded via testIgnore (Vitest + HTTP E2E cover it)
  testIgnore: 'crud/**',
  timeout: 45_000,
  expect: { timeout: 10_000 },
  fullyParallel: false,
  workers: 1,
  retries: 0,
  reporter: [['list']],
  use: {
    baseURL: frontendUrl,
    headless: true,
    screenshot: 'only-on-failure',
    trace: 'retain-on-failure',
  },
  projects: [{ name: 'chromium', use: { browserName: 'chromium' } }],
});

export { frontendUrl, backendUrl };
