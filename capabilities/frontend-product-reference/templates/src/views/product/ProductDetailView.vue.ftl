<script setup lang="ts">
// Product Detail (generated by engineering-platform frontend-product-reference asset)
// Real detail workspace (not a disabled edit form): clear information hierarchy.
import { onMounted, ref } from 'vue';
import { useRoute, useRouter } from 'vue-router';
import PageHeader from '../../components/PageHeader.vue';
import PageContainer from '../../components/PageContainer.vue';
import StatusTag from '../../components/StatusTag.vue';
import ConfirmAction from '../../components/ConfirmAction.vue';
import PermissionButton from '../../permission/PermissionButton.vue';
import { productApi } from '../../api/product';
import type { Product } from '../../types/product';
import { errorMessage, notifySuccess, toastSuccess } from '../../utils/feedback';

const route = useRoute();
const router = useRouter();
const product = ref<Product | null>(null);
const loading = ref(false);
const error = ref<string | null>(null);
const notFound = ref(false);

async function load(): Promise<void> {
  loading.value = true;
  error.value = null;
  notFound.value = false;
  try {
    product.value = await productApi.detail(Number(route.params.id));
  } catch (e) {
    error.value = errorMessage(e);
    if (e instanceof Error && 'status' in e && (e as { status: number }).status === 404) {
      notFound.value = true;
    }
  } finally {
    loading.value = false;
  }
}

async function disable(): Promise<void> {
  if (!product.value) {
    return;
  }
  try {
    await productApi.disable(product.value.id);
    notifySuccess('Product disabled');
    await load();
  } catch (e) {
    toastSuccess(errorMessage(e));
  }
}

function goBack(): void {
  router.push({ path: '/products' });
}

onMounted(load);
</script>

<template>
  <PageContainer>
    <PageHeader
      :title="product ? product.code : 'Product Detail'"
      :description="product ? product.name : undefined"
    >
      <template #actions>
        <el-button data-testid="product-detail-back" @click="goBack">Back</el-button>
        <PermissionButton
          v-if="product"
          permission="product:item:update"
          data-testid="product-detail-edit"
          @click="router.push({ path: '/products/' + product.id + '/edit' })"
        >
          Edit
        </PermissionButton>
        <ConfirmAction
          v-if="product && product.status === 'ENABLED'"
          :title="'Disable ' + product.code + '?'"
          data-testid="product-detail-disable-confirm"
          @confirm="disable"
        >
          <PermissionButton permission="product:item:disable" type="danger" plain data-testid="product-detail-disable">
            Disable
          </PermissionButton>
        </ConfirmAction>
      </template>
    </PageHeader>

    <div v-if="loading" class="detail-state" data-testid="product-detail-loading">Loading…</div>

    <el-result
      v-else-if="notFound"
      icon="warning"
      title="Product not found"
      sub-title="It may have been removed or is outside your data scope."
      data-testid="product-detail-notfound"
    >
      <template #extra>
        <el-button type="primary" @click="goBack">Back to list</el-button>
      </template>
    </el-result>

    <el-result
      v-else-if="error"
      icon="error"
      :title="error"
      data-testid="product-detail-error"
    >
      <template #extra>
        <el-button type="primary" data-testid="product-detail-retry" @click="load">Retry</el-button>
      </template>
    </el-result>

    <div v-else-if="product" class="product-detail" data-testid="product-detail">
      <section class="detail-section">
        <h3 class="detail-section-title">Basic information</h3>
        <dl class="detail-grid">
          <div class="detail-item"><dt>Code</dt><dd data-testid="detail-code">{{ product.code }}</dd></div>
          <div class="detail-item"><dt>Name</dt><dd data-testid="detail-name">{{ product.name }}</dd></div>
          <div class="detail-item">
            <dt>Status</dt>
            <dd><StatusTag :enabled="product.status === 'ENABLED'" active-text="Enabled" inactive-text="Disabled" /></dd>
          </div>
          <div class="detail-item"><dt>Category</dt><dd data-testid="detail-category">{{ product.category ?? '—' }}</dd></div>
        </dl>
      </section>

      <section class="detail-section">
        <h3 class="detail-section-title">Ownership</h3>
        <dl class="detail-grid">
          <div class="detail-item"><dt>Department</dt><dd data-testid="detail-department">{{ product.departmentId ?? '—' }}</dd></div>
          <div class="detail-item"><dt>Created by</dt><dd data-testid="detail-createdby">{{ product.createdBy ?? '—' }}</dd></div>
        </dl>
      </section>

      <section class="detail-section">
        <h3 class="detail-section-title">Audit</h3>
        <dl class="detail-grid">
          <div class="detail-item"><dt>Created at</dt><dd>{{ new Date(product.createdAt).toLocaleString() }}</dd></div>
          <div class="detail-item"><dt>Updated at</dt><dd>{{ new Date(product.updatedAt).toLocaleString() }}</dd></div>
        </dl>
      </section>
    </div>
  </PageContainer>
</template>

