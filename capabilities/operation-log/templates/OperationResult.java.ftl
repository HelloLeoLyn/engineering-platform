package ${package}.common.security;

/**
 * Operation result (generated by engineering-platform ${asset.version}).
 */
public enum OperationResult {

    SUCCESS("SUCCESS"),
    FAILURE("FAILURE");

    private final String code;

    OperationResult(String code) {
        this.code = code;
    }

    public String code() {
        return code;
    }

    public static OperationResult fromCode(String code) {
        if (code == null) {
            return null;
        }
        for (OperationResult r : values()) {
            if (r.code.equals(code)) {
                return r;
            }
        }
        return null;
    }
}
