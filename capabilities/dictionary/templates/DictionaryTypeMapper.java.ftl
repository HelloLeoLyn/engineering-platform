package ${package}.infrastructure.persistence.mapper;

import ${package}.domain.entity.DictionaryType;
import org.apache.ibatis.annotations.Mapper;
import org.apache.ibatis.annotations.Param;
import org.apache.ibatis.annotations.Select;

/**
 * MyBatis mapper for DictionaryType (generated by engineering-platform ${asset.version}).
 * Persistence implementation only — never leaks into business/API layers.
 * Hand-written SQL keeps the domain entity annotation-free (MyBatis leakage gate).
 */
@Mapper
public interface DictionaryTypeMapper {

    @Select("SELECT id, code, name, enabled, description, created_at, updated_at "
            + "FROM sys_dictionary_type WHERE code = #{code}")
    DictionaryType findByCode(@Param("code") String code);
}
