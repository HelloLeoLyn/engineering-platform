package ${package}.common.core;

import java.util.UUID;

/**
 * Stable ID generator contract (generated by engineering-platform ${asset.version}).
 * Simple, framework-neutral; no distributed ID platform for V0.4.
 */
public interface IdGenerator {

    String nextId();

    /** UUID-based generator (collision-free, simple). */
    static IdGenerator uuid() {
        return UuidGenerator.INSTANCE;
    }

    /** Monotonic generator with instance prefix, useful for tests/ordering. */
    static IdGenerator monotonic(String prefix) {
        return new MonotonicGenerator(prefix);
    }

    final class UuidGenerator implements IdGenerator {
        private static final UuidGenerator INSTANCE = new UuidGenerator();

        private UuidGenerator() {
        }

        @Override
        public String nextId() {
            return UUID.randomUUID().toString().replace("-", "");
        }
    }

    final class MonotonicGenerator implements IdGenerator {
        private static final java.util.concurrent.atomic.AtomicLong SEQ = new java.util.concurrent.atomic.AtomicLong(0);
        private final String prefix;

        private MonotonicGenerator(String prefix) {
            this.prefix = prefix;
        }

        @Override
        public String nextId() {
            return prefix + "-" + SEQ.incrementAndGet();
        }
    }
}
