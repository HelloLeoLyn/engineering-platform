// Supplier API service tests (generated by engineering-platform frontend-supplier-reference asset)
import { describe, it, expect, vi, beforeEach } from 'vitest';
import { http } from '../src/api/request';
import { supplierApi } from '../src/api/supplier';
import type { Supplier } from '../src/types/supplier';

const supplier: Supplier = {
  id: '1', code: 'SUP-001', name: 'P-HQ-1', status: 'ENABLED', category: 'ELECTRONIC',
  departmentId: '1', createdBy: '1', createdAt: '2026-08-15T00:00:00', updatedAt: '2026-08-15T00:00:00',
};

describe('supplierApi', () => {
  beforeEach(() => {
    vi.restoreAllMocks();
  });

  it('page builds query string with filters', async () => {
    const spy = vi.spyOn(http, 'get').mockResolvedValue({ items: [supplier], total: 1, page: 1, size: 20 });
    await supplierApi.page({ page: 1, size: 20, keyword: 'PRD', status: 'ENABLED', category: 'ELECTRONIC' });
    const [path] = spy.mock.calls[0] as [string];
    expect(path).toContain('page=1');
    expect(path).toContain('keyword=PRD');
    expect(path).toContain('status=ENABLED');
    expect(path).toContain('category=ELECTRONIC');
  });

  it('page omits empty filters', async () => {
    const spy = vi.spyOn(http, 'get').mockResolvedValue({ items: [], total: 0, page: 1, size: 20 });
    await supplierApi.page({ page: 1, size: 20 });
    const [path] = spy.mock.calls[0] as [string];
    expect(path).not.toContain('keyword=');
    expect(path).not.toContain('status=');
  });

  it('detail/create/update/disable route to the right paths', async () => {
    const get = vi.spyOn(http, 'get').mockResolvedValue(supplier);
    const post = vi.spyOn(http, 'post').mockResolvedValue(supplier);
    const put = vi.spyOn(http, 'put').mockResolvedValue(supplier);

    await supplierApi.detail('5');
    expect((get.mock.calls[0] as [string])[0]).toBe('/suppliers/5');

    await supplierApi.create({ code: 'X', name: 'Y', status: 'ENABLED', category: null });
    expect((post.mock.calls[0] as [string])[0]).toBe('/suppliers');

    await supplierApi.update('5', { code: 'X', name: 'Y', status: 'DISABLED', category: null });
    expect((put.mock.calls[0] as [string])[0]).toBe('/suppliers/5');

    await supplierApi.disable('5');
    expect((post.mock.calls[1] as [string])[0]).toBe('/suppliers/5/disable');
  });
});
