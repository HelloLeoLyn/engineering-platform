<script setup lang="ts">
// Supplier Edit (generated by engineering-platform frontend-supplier-reference asset)
// Real update surface: loads existing supplier, updates via PUT.
// createdBy / department ownership come from the server session — never editable.
import { onMounted, reactive, ref } from 'vue';
import { useRoute, useRouter } from 'vue-router';
import PageHeader from '../../components/PageHeader.vue';
import PageContainer from '../../components/PageContainer.vue';
import AppForm from '../../components/AppForm.vue';
import DictionarySelect from '../../components/DictionarySelect.vue';
import { supplierApi } from '../../api/supplier';
import type { Supplier } from '../../types/supplier';
import { errorMessage, notifySuccess } from '../../utils/feedback';

const route = useRoute();
const router = useRouter();
const supplier = ref<Supplier | null>(null);
const loading = ref(false);
const error = ref<string | null>(null);
const notFound = ref(false);
const submitting = ref(false);
const formError = ref<string | null>(null);

const form = reactive({ code: '', name: '', status: 'ENABLED', category: '' });

async function load(): Promise<void> {
  loading.value = true;
  error.value = null;
  notFound.value = false;
  try {
    const p = await supplierApi.detail(route.params.id as string);
    supplier.value = p;
    Object.assign(form, { code: p.code, name: p.name, status: p.status, category: p.category ?? '' });
  } catch (e) {
    error.value = errorMessage(e);
    if (e instanceof Error && 'status' in e && (e as { status: number }).status === 404) {
      notFound.value = true;
    }
  } finally {
    loading.value = false;
  }
}

async function submit(): Promise<void> {
  if (!supplier.value) {
    return;
  }
  submitting.value = true;
  formError.value = null;
  try {
    await supplierApi.update(supplier.value.id, {
      code: form.code,
      name: form.name,
      status: form.status,
      category: form.category || null,
    });
    notifySuccess('Supplier updated');
    router.push({ path: '/suppliers/' + supplier.value.id });
  } catch (e) {
    formError.value = errorMessage(e);
  } finally {
    submitting.value = false;
  }
}

onMounted(load);
</script>

<template>
  <PageContainer>
    <PageHeader title="Edit Supplier" :description="supplier ? supplier.code : undefined">
      <template #actions>
        <el-button data-testid="supplier-edit-cancel" @click="router.push({ path: '/suppliers' })">Cancel</el-button>
      </template>
    </PageHeader>

    <div v-if="loading" class="edit-state" data-testid="supplier-edit-loading">Loading…</div>

    <el-result
      v-else-if="notFound"
      icon="warning"
      title="Supplier not found"
      sub-title="It may have been removed or is outside your data scope."
      data-testid="supplier-edit-notfound"
    />

    <el-result v-else-if="error" icon="error" :title="error" data-testid="supplier-edit-error" />

    <div v-else-if="supplier" class="supplier-edit" data-testid="supplier-edit">
      <AppForm
        :model="form as unknown as Record<string, unknown>"
        :submitting="submitting"
        :error="formError"
        submit-text="Save"
        @submit="submit"
        @cancel="router.push({ path: '/suppliers/' + supplier.id })"
      >
        <el-form-item label="Code" :rules="[{ required: true, message: 'Code is required' }]">
          <el-input v-model="form.code" data-testid="supplier-edit-code" />
        </el-form-item>
        <el-form-item label="Name" :rules="[{ required: true, message: 'Name is required' }]">
          <el-input v-model="form.name" data-testid="supplier-edit-name" />
        </el-form-item>
        <el-form-item label="Status">
          <DictionarySelect v-model="form.status" code="supplier_status" style="width: 100%" data-testid="supplier-edit-status" />
        </el-form-item>
        <el-form-item label="Category">
          <DictionarySelect v-model="form.category" code="supplier_category" clearable style="width: 100%" data-testid="supplier-edit-category" />
        </el-form-item>
        <div class="edit-meta">
          <span>Created by: {{ supplier.createdBy ?? '—' }}</span>
          <span>Department: {{ supplier.departmentId ?? '—' }}</span>
          <span class="edit-meta-hint">Ownership is server-managed and cannot be changed here.</span>
        </div>
      </AppForm>
    </div>
  </PageContainer>
</template>

