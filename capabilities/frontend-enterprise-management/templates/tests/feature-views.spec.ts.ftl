describe('OperationLogView', () => {
  beforeEach(() => {
    vi.restoreAllMocks();
  });

  it('loads paged logs via platform API (read-only surface)', async () => {
    vi.spyOn(operationLogApi, 'page').mockResolvedValue({
      items: [
        {
          id: 1, userId: 1, operation: 'USER_CREATE', resourceType: 'USER', resourceId: '5',
          result: 'SUCCESS', requestId: 'req-1', correlationId: 'corr-1', method: 'POST',
          path: '/api/users', occurredAt: '2026-08-15T00:00:00',
        },
      ],
      total: 1, page: 1, size: 20,
    });
    seed(['system:operation-log:read']);
    const wrapper = mountWith(OperationLogView);
    await flushPromises();
    expect(operationLogApi.page).toHaveBeenCalled();
    expect(wrapper.find('[data-testid="oplog-filter-operation"]').exists()).toBe(true);
  });

  it('no write controls on operation log (read-only)', async () => {
    vi.spyOn(operationLogApi, 'page').mockResolvedValue({ items: [], total: 0, page: 1, size: 20 });
    seed(['system:operation-log:read']);
    const wrapper = mountWith(OperationLogView);
    await flushPromises();
    expect(wrapper.find('[data-testid="oplog-create"]').exists()).toBe(false);
    expect(wrapper.find('[data-testid="oplog-delete"]').exists()).toBe(false);
  });
});
