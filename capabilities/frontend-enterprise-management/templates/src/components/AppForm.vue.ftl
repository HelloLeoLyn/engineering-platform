<script setup lang="ts">
// AppForm (generated by engineering-platform frontend-enterprise-management asset)
// Unified form container: grouped fields, validation, submit loading, dirty state,
// cancel, error feedback. Renders into el-form with a stable action footer.
// Layout strategy: small form -> Dialog; medium edit -> Drawer; complex -> page.
import { ref, watch } from 'vue';
import type { FormInstance, FormRules } from 'element-plus';

const props = withDefaults(
  defineProps<{
    model: Record<string, unknown>;
    rules?: FormRules;
    labelWidth?: string;
    submitting?: boolean;
    error?: string | null;
    submitText?: string;
    cancelText?: string;
    /** Compact mode for drawers/dialogs (footer aligned right, no grouping gap). */
    compact?: boolean;
  }>(),
  {
    rules: undefined,
    labelWidth: '140px',
    submitting: false,
    error: null,
    submitText: 'Save',
    cancelText: 'Cancel',
    compact: false,
  },
);

const emit = defineEmits<{ submit: []; cancel: [] }>();

const formRef = ref<FormInstance>();
const dirty = ref(false);

watch(
  () => props.model,
  () => {
    dirty.value = true;
  },
  { deep: true },
);

async function handleSubmit(): Promise<void> {
  if (!formRef.value || typeof formRef.value.validate !== 'function') {
    emit('submit');
    return;
  }
  const valid = await formRef.value.validate().catch(() => false);
  if (valid) {
    emit('submit');
  }
}
</script>

<template>
  <div class="app-form" data-testid="app-form">
    <el-alert
      v-if="error"
      type="error"
      :title="error"
      show-icon
      :closable="false"
      class="app-form-error"
      data-testid="app-form-error"
    />
    <el-form
      ref="formRef"
      :model="model"
      :rules="rules"
      :label-width="labelWidth"
      class="app-form-body"
    >
      <slot />
    </el-form>
    <div class="app-form-footer" :class="{ 'app-form-footer--compact': compact }">
      <el-button :disabled="submitting" @click="emit('cancel')">{{ cancelText }}</el-button>
      <el-button type="primary" :loading="submitting" data-testid="app-form-submit" @click="handleSubmit">
        {{ submitText }}
      </el-button>
    </div>
  </div>
</template>

<style scoped>
.app-form-error {
  margin-bottom: var(--ep-space-4);
}
.app-form-footer {
  display: flex;
  justify-content: flex-end;
  gap: var(--ep-space-3);
  padding-top: var(--ep-space-4);
  border-top: 1px solid var(--el-border-color-light);
  margin-top: var(--ep-space-4);
}
.app-form-footer--compact {
  border-top: none;
  margin-top: var(--ep-space-3);
}
</style>
