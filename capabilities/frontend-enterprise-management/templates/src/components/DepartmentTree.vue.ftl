<script setup lang="ts">
// DepartmentTree (generated by engineering-platform frontend-enterprise-management asset)
// Reusable department tree: loading / selected node / disabled state / empty / refresh / stable key.
// Business CRUD stays OUT of this component.
import { onMounted, ref, watch } from 'vue';
import type { DepartmentNode } from '../types/enterprise';
import { departmentApi } from '../api/enterprise';

const props = withDefaults(
  defineProps<{
    selectedId?: number | null;
    /** Node ids shown as disabled (e.g. current node when editing parent). */
    disabledIds?: number[];
    /** When true, load data from the backend itself; else use `nodes`. */
    selfLoad?: boolean;
    nodes?: DepartmentNode[];
  }>(),
  { selectedId: null, disabledIds: () => [], selfLoad: false, nodes: () => [] },
);

const emit = defineEmits<{
  select: [id: number];
  loaded: [nodes: DepartmentNode[]];
}>();

const loading = ref(false);
const error = ref<string | null>(null);
const treeData = ref<DepartmentNode[]>(props.nodes);
const treeRef = ref();

async function load(): Promise<void> {
  if (!props.selfLoad) {
    return;
  }
  loading.value = true;
  error.value = null;
  try {
    const data = await departmentApi.tree();
    treeData.value = data;
    emit('loaded', data);
  } catch (e) {
    error.value = e instanceof Error ? e.message : 'Failed to load departments';
  } finally {
    loading.value = false;
  }
}

watch(
  () => props.nodes,
  (nodes) => {
    treeData.value = nodes;
  },
);

function onNodeClick(data: DepartmentNode): void {
  emit('select', data.department.id);
}

onMounted(load);

defineExpose({ load, treeData });
</script>

<template>
  <div class="department-tree" data-testid="department-tree">
    <div v-if="error" class="department-tree-error">
      <span>{{ error }}</span>
      <el-button size="small" @click="load">Retry</el-button>
    </div>
    <el-tree
      v-else
      ref="treeRef"
      v-loading="loading"
      :data="treeData"
      :props="{ label: 'name', children: 'children' }"
      node-key="id"
      :default-expand-all="true"
      highlight-current
      :current-node-key="selectedId ?? undefined"
      data-testid="department-tree-body"
      @node-click="onNodeClick"
    >
      <template #default="{ node, data }">
        <span
          class="department-tree-node"
          :class="{ 'is-disabled': !data.department.enabled }"
          :data-testid="'department-node-' + (data.department.id)"
        >
          {{ node.label }}
        </span>
      </template>
    </el-tree>
  </div>
</template>

<style scoped>
.department-tree-error {
  display: flex;
  align-items: center;
  gap: var(--ep-space-3);
  color: var(--el-color-danger);
  padding: var(--ep-space-3);
}
.department-tree-node.is-disabled {
  color: var(--el-text-color-disabled);
}
</style>
