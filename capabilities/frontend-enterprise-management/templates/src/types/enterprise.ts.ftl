  enabled: boolean;
  dataScope: DataScope;
  permissionIds: number[];
  createdAt: string;
}

export interface RoleCreateRequest {
  code: string;
  name?: string;
  dataScope?: DataScope;
  permissionIds?: number[];
}

export interface RoleUpdateRequest {
  name?: string;
  dataScope?: DataScope;
  permissionIds?: number[];
}

// ---- permission ----

export interface Permission {
  id: number;
  code: string;
