// Enterprise management types (generated by engineering-platform frontend-enterprise-management asset)
// Stable TS models for User/Role/Permission/Department/Menu/Dictionary/OperationLog.
// No `any` / `Record<string, any>` in the typed surface.

// ---- paging (backend PageResult<T>: { items, total, page, size }) ----

export interface PageResult<T> {
  items: T[];
  total: number;
  page: number;
  size: number;
}

// ---- user ----

export interface User {
  id: number;
  username: string;
  enabled: boolean;
  departmentId: number | null;
  roleIds: number[];
  createdAt: string;
}

export interface UserCreateRequest {
  username: string;
  initialPassword?: string;
  departmentId?: number | null;
  roleIds?: number[];
}

export interface UserUpdateRequest {
  username?: string;
  departmentId?: number | null;
  roleIds?: number[];
}

export interface UserCreateResult {
  user: User;
  initialPassword: string;
}

