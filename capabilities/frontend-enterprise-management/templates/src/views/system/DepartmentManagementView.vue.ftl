<script setup lang="ts">
// Department Management (generated by engineering-platform frontend-enterprise-management asset)
// Two-pane workspace: department tree (left) + detail/edit (right).
// Handles self-parent / cycle errors, disabled state, stable tree ordering.
import { computed, onMounted, reactive, ref } from 'vue';
import PageHeader from '../../components/PageHeader.vue';
import PageContainer from '../../components/PageContainer.vue';
import DepartmentTree from '../../components/DepartmentTree.vue';
import StatusTag from '../../components/StatusTag.vue';
import ConfirmAction from '../../components/ConfirmAction.vue';
import PermissionButton from '../../permission/PermissionButton.vue';
import { departmentApi } from '../../api/enterprise';
import type { Department, DepartmentNode } from '../../types/enterprise';
import { flattenDepartments } from '../../utils/tree';
import { errorMessage, notifySuccess, toastSuccess } from '../../utils/feedback';

const tree = ref<DepartmentNode[]>([]);
const treeError = ref<string | null>(null);
const selected = ref<Department | null>(null);
const editing = ref(false);
const creating = ref(false);
const saving = ref(false);
const formError = ref<string | null>(null);

const form = reactive({
  code: '',
  name: '',
  parentId: null as number | null,
  sort: 0,
});

const parentOptions = computed(() => {
  if (!tree.value.length) {
    return [];
  }
  const all = flattenDepartments(tree.value);
  // exclude self + descendants when editing (prevents cycle/self-parent)
  const exclude = new Set<number>();
  if (selected.value) {
    exclude.add(selected.value.id);
    const walk = (nodes: DepartmentNode[]): void => {
      for (const n of nodes) {
        if (n.department.parentId === selected.value!.id || exclude.has(n.department.parentId ?? -1)) {
          // descendants of selected
        }
        if (n.department.id === selected.value!.id) {
          const collect = (list: DepartmentNode[]): void => {
            for (const c of list) {
              exclude.add(c.department.id);
              collect(c.children);
            }
          };
          collect(n.children);
        }
        walk(n.children);
      }
    };
    walk(tree.value);
  }
  return all.filter((d) => !exclude.has(d.id));
});

async function loadTree(): Promise<void> {
  try {
    tree.value = await departmentApi.tree();
    treeError.value = null;
  } catch (e) {
    treeError.value = errorMessage(e);
  }
}

function onSelect(id: number): void {
  const found = flattenDepartments(tree.value).find((d) => d.id === id);
  if (found) {
    selected.value = found;
    creating.value = false;
    editing.value = false;
    formError.value = null;
    syncForm(found);
  }
}

function syncForm(d: Department): void {
  Object.assign(form, { code: d.code, name: d.name, parentId: d.parentId, sort: d.sort });
}

function startCreate(): void {
  creating.value = true;
  editing.value = false;
  formError.value = null;
  Object.assign(form, { code: '', name: '', parentId: selected.value?.id ?? null, sort: 0 });
}

function startEdit(): void {
  if (!selected.value) {
    return;
  }
  editing.value = true;
  creating.value = false;
  formError.value = null;
  syncForm(selected.value);
}

async function save(): Promise<void> {
  saving.value = true;
  formError.value = null;
  try {
    if (creating.value) {
      const created = await departmentApi.create({ code: form.code, name: form.name, parentId: form.parentId, sort: form.sort });
      notifySuccess('Department created');
      await loadTree();
      onSelect(created.id);
    } else if (selected.value) {
      const updated = await departmentApi.update(selected.value.id, { name: form.name, parentId: form.parentId, sort: form.sort });
      notifySuccess('Department updated');
      await loadTree();
      onSelect(updated.id);
    }
    creating.value = false;
    editing.value = false;
  } catch (e) {
    formError.value = errorMessage(e);
  } finally {
    saving.value = false;
  }
}

async function setEnabled(d: Department, enabled: boolean): Promise<void> {
  try {
    if (enabled) {
      await departmentApi.enable(d.id);
      toastSuccess('Department enabled');
    } else {
      await departmentApi.disable(d.id);
      toastSuccess('Department disabled');
    }
    await loadTree();
    if (selected.value?.id === d.id) {
      selected.value = { ...d, enabled };
      syncForm(selected.value);
    }
  } catch (e) {
    toastSuccess(errorMessage(e));
  }
}

function cancelEdit(): void {
  creating.value = false;
  editing.value = false;
  formError.value = null;
  if (selected.value) {
    syncForm(selected.value);
  }
}

onMounted(loadTree);
</script>

<template>
  <PageContainer full-width>
    <PageHeader title="Department Management" description="Organize the department tree; structure is validated to prevent cycles.">
      <template #actions>
        <PermissionButton permission="system:department:create" type="primary" data-testid="create-department" @click="startCreate">
          Create Department
        </PermissionButton>
      </template>
    </PageHeader>

    <div class="department-layout" data-testid="department-layout">
      <aside class="department-tree-pane">
        <div v-if="treeError" class="tree-error">
          <span>{{ treeError }}</span>
          <el-button size="small" @click="loadTree">Retry</el-button>
        </div>
        <DepartmentTree
          v-else
          self-load
          :nodes="tree"
          :selected-id="selected?.id ?? null"
          data-testid="department-tree-pane"
          @select="onSelect"
          @loaded="(nodes: DepartmentNode[]) => { tree = nodes; }"
        />
      </aside>

      <main class="department-workspace" data-testid="department-workspace">
        <el-empty v-if="!selected && !creating" description="Select a department on the left" />
        <div v-else>
          <el-alert v-if="formError" type="error" :title="formError" :closable="false" class="form-alert" />
          <div class="workspace-header">
            <div>
              <h3 class="workspace-title">
                {{ creating ? 'New department' : (selected?.name ?? '') }}
              </h3>
              <span v-if="!creating && selected" class="workspace-subtitle">{{ selected?.code }}</span>
            </div>
            <div v-if="!creating && selected" class="workspace-header-actions">
              <StatusTag :enabled="selected!.enabled" />
              <PermissionButton v-if="!editing" permission="system:department:update" data-testid="edit-department" @click="startEdit">
                Edit
              </PermissionButton>
              <ConfirmAction
                v-if="!editing && selected!.enabled"
                title="Disable this department?"
                message="Disabled departments cannot be assigned to new users."
                data-testid="disable-department-confirm"
              >
                <PermissionButton permission="system:department:disable" type="danger" plain>Disable</PermissionButton>
              </ConfirmAction>
              <PermissionButton
                v-if="!editing && !selected!.enabled"
                permission="system:department:update"
                data-testid="enable-department"
                @click="setEnabled(selected!, true)"
              >
                Enable
              </PermissionButton>
            </div>
          </div>

          <el-form :model="form" label-width="120px" class="dept-form">
            <el-form-item label="Code" :rules="[{ required: true, message: 'Code is required' }]">
              <el-input v-model="form.code" :disabled="!creating" placeholder="e.g. SALES_EAST" data-testid="dept-form-code" />
              <div v-if="!creating" class="form-hint">Code is immutable once created.</div>
            </el-form-item>
            <el-form-item label="Name">
              <el-input v-model="form.name" data-testid="dept-form-name" />
            </el-form-item>
            <el-form-item label="Parent">
              <el-select
                v-model="form.parentId"
                clearable
                filterable
                placeholder="Root"
                style="width: 100%"
                data-testid="dept-form-parent"
              >
                <el-option v-for="d in parentOptions" :key="d.id" :label="d.name" :value="d.id" />
              </el-select>
              <div class="form-hint">Self and descendants are excluded to prevent cycles.</div>
            </el-form-item>
            <el-form-item label="Sort">
              <el-input-number v-model="form.sort" :min="0" data-testid="dept-form-sort" />
            </el-form-item>
          </el-form>

          <div v-if="editing || creating" class="workspace-actions">
            <el-button @click="cancelEdit">Cancel</el-button>
            <el-button type="primary" :loading="saving" data-testid="dept-save" @click="save">
              {{ creating ? 'Create' : 'Save' }}
            </el-button>
          </div>
        </div>
      </main>
    </div>
  </PageContainer>
</template>

